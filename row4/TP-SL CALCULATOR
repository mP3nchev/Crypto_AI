// =====================================================
// TP/SL CALCULATOR v3.0 - Dynamic Allocation
// =====================================================
// Changes:
// - Uses latest_1m_price for current price
// - 3 TP levels (removed TP4)
// - Dynamic allocation based on trend_score
// - Risk-based TP calculations (R/R ratios)
// - Tier-adjusted TP3 for strong trends
// =====================================================

console.log('🎯 ╔══════════════════════════════════════════════╗');
console.log('   TP/SL CALCULATOR v3.0 - Dynamic Allocation');
console.log('╚══════════════════════════════════════════════╝');

const inputData = $input.all();
console.log(`📊 Calculating TP/SL levels for ${inputData.length} symbols`);

if (inputData.length === 0) {
  console.log('⚠️ No input data received');
  return [];
}

// =====================================================
// CONFIGURATION
// =====================================================
const TRADING_FEES = {
  entry: 0.00055,
  exit: 0.00055,
  total: 0.0011
};

const SL_MULTIPLIERS = {
  1: 1.5,
  2: 2.0,
  3: 2.5
};

const MAX_LEVERAGE = {
  1: 10,
  2: 7,
  3: 5
};

function getTierAdjustedTP3(tier) {
  if (tier === 1) return 2.5;
  if (tier === 2) return 3.5;
  if (tier === 3) return 4.5;
  return 3.0;
}

function getDynamicAllocation(trendScore, tier) {
  if (trendScore >= 70) {
    return {
      allocation: [40, 40, 20],
      tp_ratios: [1.5, 2.0, getTierAdjustedTP3(tier)],
      strategy: 'STRONG_TREND'
    };

  } else if (trendScore >= 50) {
    return {
      allocation: [50, 35, 15],
      tp_ratios: [1.3, 2.0, 3.0],
      strategy: 'MODERATE_TREND'
    };

  } else {
    // WEAK/RANGING - secure profits early, reduce TP1 allocation to let more run to TP2
    return {
      allocation: [50, 35, 15],
      tp_ratios: [1.2, 1.5, 2.5],
      strategy: 'WEAK_RANGING'
    };
  }
}

const results = [];

for (const item of inputData) {
  const data = item.json;
  const symbol = data.symbol;
  
  console.log(`\n${'='.repeat(60)}`);
  console.log(`📊 ${symbol} - TP/SL Calculation`);
  console.log('='.repeat(60));
  
  // [T-06] Resolve current price with 3% deviation sanity check.
  // If 1m price deviates >3% from 2h close, substitute close_price (safer for TP/SL math).
  const raw1mPrice    = parseFloat(data.latest_1m_price) || 0;
  const fallbackPrice = parseFloat(data.close_price || data.current_price || 0);
  let currentPrice;
  if (raw1mPrice > 0 && fallbackPrice > 0) {
    const deviation = Math.abs(raw1mPrice - fallbackPrice) / fallbackPrice;
    if (deviation > 0.03) {
      console.warn(`[T-06] 1m price deviation ${(deviation * 100).toFixed(2)}% > 3% for ${symbol}: 1m=${raw1mPrice}, 2h_close=${fallbackPrice} -- substituting close_price`);
      currentPrice = fallbackPrice;
    } else {
      currentPrice = raw1mPrice;
    }
  } else {
    currentPrice = raw1mPrice || fallbackPrice;
  }

  const atr = parseFloat(data.current_atr_1h || 0);
  const tier = parseInt(data.tier || 2);
  const direction = data.signal_direction || 'NEUTRAL';
  const trendScore = parseFloat(data.trend_score || 50);
  const totalScore = parseFloat(data.total_score || 0);
  
  console.log(`  Price (1m): $${currentPrice.toFixed(8)}`);
  console.log(`  ATR 1h: $${atr.toFixed(8)}`);
  console.log(`  Tier: ${tier}`);
  console.log(`  Direction: ${direction}`);
  console.log(`  Trend Score: ${trendScore}/100`);
  
  if (currentPrice <= 0 || atr <= 0 || !['LONG', 'SHORT'].includes(direction)) {
    console.log(`  SKIP: Invalid data (price=${currentPrice}, atr=${atr}, dir=${direction})`);
    results.push({
      json: {
        ...data,
        tp_sl_valid: false,
        rejection_reason: 'Invalid price/ATR/direction data'
      }
    });
    continue;
  }
  
  const dynamics = getDynamicAllocation(trendScore, tier);
  
  console.log(`\n  Strategy: ${dynamics.strategy}`);
  console.log(`  Allocation: ${dynamics.allocation.join('/')}%`);
  console.log(`  TP Ratios: ${dynamics.tp_ratios.join('/')}`);
  
  const slMultiplier = SL_MULTIPLIERS[tier] || 2.0;
  let stopLoss;
  
  if (direction === 'LONG') {
    stopLoss = currentPrice - (atr * slMultiplier);
  } else {
    stopLoss = currentPrice + (atr * slMultiplier);
  }
  
  const slDistance = Math.abs(currentPrice - stopLoss);
  const slDistancePct = (slDistance / currentPrice) * 100;
  
  const risk = Math.abs(stopLoss - currentPrice);
  let tp1, tp2, tp3;
  
  if (direction === 'LONG') {
    tp1 = currentPrice + (risk * dynamics.tp_ratios[0]);
    tp2 = currentPrice + (risk * dynamics.tp_ratios[1]);
    tp3 = currentPrice + (risk * dynamics.tp_ratios[2]);
  } else {
    tp1 = currentPrice - (risk * dynamics.tp_ratios[0]);
    tp2 = currentPrice - (risk * dynamics.tp_ratios[1]);
    tp3 = currentPrice - (risk * dynamics.tp_ratios[2]);
  }
  
  const tp1Pct = (Math.abs(tp1 - currentPrice) / currentPrice) * 100;
  const tp2Pct = (Math.abs(tp2 - currentPrice) / currentPrice) * 100;
  const tp3Pct = (Math.abs(tp3 - currentPrice) / currentPrice) * 100;
  
  let effEntry, effSL, effTP1, effTP2, effTP3;
  let riskWithFees, rewardTP1, rewardTP2, rewardTP3;

  if (direction === 'LONG') {
    effEntry = currentPrice * (1 + TRADING_FEES.entry);
    effSL    = stopLoss * (1 - TRADING_FEES.exit);
    effTP1   = tp1 * (1 - TRADING_FEES.exit);
    effTP2   = tp2 * (1 - TRADING_FEES.exit);
    effTP3   = tp3 * (1 - TRADING_FEES.exit);
    riskWithFees = effEntry - effSL;
    rewardTP1    = effTP1 - effEntry;
    rewardTP2    = effTP2 - effEntry;
    rewardTP3    = effTP3 - effEntry;
  } else {
    effEntry = currentPrice * (1 - TRADING_FEES.entry);
    effSL    = stopLoss * (1 + TRADING_FEES.exit);
    effTP1   = tp1 * (1 + TRADING_FEES.exit);
    effTP2   = tp2 * (1 + TRADING_FEES.exit);
    effTP3   = tp3 * (1 + TRADING_FEES.exit);
    riskWithFees = effSL - effEntry;
    rewardTP1    = effEntry - effTP1;
    rewardTP2    = effEntry - effTP2;
    rewardTP3    = effEntry - effTP3;
  }

  if (riskWithFees <= 0) {
    console.log(`  SKIP: riskWithFees=${riskWithFees.toFixed(8)} -- fee-adjusted risk invalid`);
    results.push({
      json: {
        ...data,
        tp_sl_valid: false,
        rejection_reason: `FEE_ADJUSTED_RISK_INVALID: ${riskWithFees}`
      }
    });
    continue;
  }
  
  const rrTP1 = rewardTP1 / riskWithFees;
  const rrTP2 = rewardTP2 / riskWithFees;
  const rrTP3 = rewardTP3 / riskWithFees;
  
  const weightedRR = (
    rrTP1 * (dynamics.allocation[0] / 100) +
    rrTP2 * (dynamics.allocation[1] / 100) +
    rrTP3 * (dynamics.allocation[2] / 100)
  );
  
  console.log(`\n  ⚖️ Risk/Reward (Fee-Adjusted):`);
  console.log(`     TP1 R/R: ${rrTP1.toFixed(2)}:1`);
  console.log(`     TP2 R/R: ${rrTP2.toFixed(2)}:1`);
  console.log(`     TP3 R/R: ${rrTP3.toFixed(2)}:1`);
  console.log(`     Weighted Avg: ${weightedRR.toFixed(2)}:1`);
  
  // =====================================================
  // TIER LEVERAGE CAP (informational — leverage calculated in RISK-REWARD FILTER)
  // =====================================================
  const maxLev = MAX_LEVERAGE[tier] || 5;

  console.log(`\n  ⚡ Tier Max Leverage Cap: ${maxLev}x (Tier ${tier}) — final leverage computed in R/R Filter`);
  
  results.push({
    json: {
      ...data,
      entry_price: currentPrice,
      stop_loss: stopLoss,
      take_profit: tp2,
      take_profit_1: tp1,
      take_profit_2: tp2,
      take_profit_3: tp3,
      tp1_allocation: dynamics.allocation[0],
      tp2_allocation: dynamics.allocation[1],
      tp3_allocation: dynamics.allocation[2],
      tp1_rr: rrTP1,
      tp2_rr: rrTP2,
      tp3_rr: rrTP3,
      weighted_rr: weightedRR,
      fee_adjusted_rr: weightedRR,
      weighted_rr_ratio: weightedRR,
      fee_adjusted_rr_tp1: rrTP1,
      fee_adjusted_rr_tp2: rrTP2,
      fee_adjusted_rr_tp3: rrTP3,
      fee_adjusted_rr_tp4: 0,
      tp_strategy: dynamics.strategy,
      trend_score_used: trendScore,

      // Tier leverage cap (authoritative leverage in RISK-REWARD FILTER output)
      tier_max_leverage: maxLev,

      // Distances
      sl_distance_pct: slDistancePct,
      tp1_distance_pct: tp1Pct,
      tp2_distance_pct: tp2Pct,
      tp3_distance_pct: tp3Pct,
      tp_sl_valid: true,
      tpsl_calculated: true
    }
  });
  
  console.log(`\n  TP/SL calculation complete`);
}

console.log(`\n${'='.repeat(60)}`);
console.log(`TP/SL CALCULATION SUMMARY`);
console.log(`  Total processed: ${results.length}`);
console.log(`  Valid: ${results.filter(r => r.json.tp_sl_valid).length}`);
console.log(`  Invalid: ${results.filter(r => !r.json.tp_sl_valid).length}`);
console.log(`\nTP/SL Calculator v3.0 complete\n`);

return results;
