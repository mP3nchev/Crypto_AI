}

// [W-09] Pass-through no-signal sentinel from RISK-REWARD FILTER
if (inputData.length === 1 && inputData[0].json.is_no_signal_notification === true) {
  console.log('⚠️ [W-09] No-signal sentinel received — passing through unchanged');
  return inputData;
}

// =====================================================
// SCORING CONFIGURATION
// =====================================================
const SCORING_WEIGHTS = {
  tp1: 0.40,  // 40% weight (primary target)
  tp2: 0.30,  // 30% weight (main target)
  tp3: 0.20,  // 20% weight (extended)
  tp4: 0.10   // 10% weight (moon shot)
};

// R/R to Score mapping (linear interpolation)
const RR_SCORE_THRESHOLDS = {
  perfect: { rr: 5.0, score: 100 },   // 5:1 R/R = 100 points
  excellent: { rr: 4.0, score: 90 },  // 4:1 R/R = 90 points
  great: { rr: 3.5, score: 80 },      // 3.5:1 R/R = 80 points
  good: { rr: 3.0, score: 70 },       // 3:1 R/R = 70 points
  acceptable: { rr: 2.5, score: 60 }, // 2.5:1 R/R = 60 points
  minimum: { rr: 2.0, score: 50 },    // 2:1 R/R = 50 points
  floor: { rr: 0, score: 0 }           // 0:1 R/R = 0 points
};

// =====================================================
// HELPER: MAP R/R TO SCORE (0-100)
// =====================================================
function mapRRToScore(rrValue) {
  if (rrValue >= RR_SCORE_THRESHOLDS.perfect.rr) {
    return 100;
  }
  
  // Find the appropriate range and interpolate
  const thresholds = Object.values(RR_SCORE_THRESHOLDS).sort((a, b) => b.rr - a.rr);
  
  for (let i = 0; i < thresholds.length - 1; i++) {
    const upper = thresholds[i];
    const lower = thresholds[i + 1];
    
    if (rrValue >= lower.rr && rrValue <= upper.rr) {
      // Linear interpolation
      const rrRange = upper.rr - lower.rr;
      const scoreRange = upper.score - lower.score;
      const rrPosition = (rrValue - lower.rr) / rrRange;
      const score = lower.score + (scoreRange * rrPosition);
      return Math.round(score);
    }
  }
  
  return 0;
}

// =====================================================
// R/R SCORE CALCULATION FUNCTION
// =====================================================
function calculateRRScore(data) {
  // Extract fee-adjusted R/R for all TPs
  const rrTP1 = parseFloat(data.fee_adjusted_rr_tp1 || 0);
  const rrTP2 = parseFloat(data.fee_adjusted_rr_tp2 || 0);
  const rrTP3 = parseFloat(data.fee_adjusted_rr_tp3 || 0);
  const rrTP4 = parseFloat(data.fee_adjusted_rr_tp4 || 0);
  const weightedRR = parseFloat(data.weighted_rr_ratio || 0);
  const rrBonus = parseFloat(data.rr_bonus || 0);
  
  console.log(`  R/R Ratios (Fee-Adjusted):`);
  console.log(`    TP1: ${rrTP1.toFixed(2)}`);
  console.log(`    TP2: ${rrTP2.toFixed(2)}`);
  console.log(`    TP3: ${rrTP3.toFixed(2)}`);
  console.log(`    TP4: ${rrTP4.toFixed(2)}`);
  console.log(`    Weighted: ${weightedRR.toFixed(2)}`);
  
  // Convert each R/R to score (0-100)
  const scoreTP1 = mapRRToScore(rrTP1);
  const scoreTP2 = mapRRToScore(rrTP2);
  const scoreTP3 = mapRRToScore(rrTP3);
  const scoreTP4 = mapRRToScore(rrTP4);
  
  console.log(`  Mapped Scores:`);
  console.log(`    TP1: ${scoreTP1}/100`);
  console.log(`    TP2: ${scoreTP2}/100`);
  console.log(`    TP3: ${scoreTP3}/100`);
  console.log(`    TP4: ${scoreTP4}/100`);
  
  // Weighted average of TP scores
  const weightedScore = 
    (scoreTP1 * SCORING_WEIGHTS.tp1) +
    (scoreTP2 * SCORING_WEIGHTS.tp2) +
    (scoreTP3 * SCORING_WEIGHTS.tp3) +
    (scoreTP4 * SCORING_WEIGHTS.tp4);
  
  console.log(`  Weighted Score: ${weightedScore.toFixed(2)}/100`);
  
  // Apply R/R bonus (from previous filter)
  const finalScore = Math.min(100, weightedScore + rrBonus);
  
  if (rrBonus > 0) {
    console.log(`  R/R Bonus: +${rrBonus} points`);
  }
  console.log(`  🎯 Final R/R Score: ${finalScore.toFixed(2)}/100`);
  
  return {
    risk_reward_score: Math.round(finalScore),
    score_components: {
      tp1_score: scoreTP1,
      tp2_score: scoreTP2,
      tp3_score: scoreTP3,
      tp4_score: scoreTP4,
      weighted_base_score: parseFloat(weightedScore.toFixed(2)),
      bonus_applied: rrBonus,
      final_score: Math.round(finalScore)
    },
    scoring_weights: SCORING_WEIGHTS
  };
}

// =====================================================
// PROCESS EACH SYMBOL
// =====================================================
// =====================================================
// [T-07] SIGNAL STRENGTH RECLASSIFICATION (after rr_bonus injection)
// Mirrors the thresholds used by SCORE AGGREGATOR so downstream Telegram and
// Hard Filters see the same classification scheme regardless of source.
// =====================================================
function classifyByScore(score) {
  if (score >= 85) return { signal_strength: 'VERY_STRONG', confidence_level: 'VERY_HIGH' };
  if (score >= 75) return { signal_strength: 'STRONG',      confidence_level: 'HIGH' };
  if (score >= 65) return { signal_strength: 'MEDIUM',      confidence_level: 'MEDIUM' };
  if (score >= 50) return { signal_strength: 'WEAK',        confidence_level: 'LOW' };
  return            { signal_strength: 'VERY_WEAK',         confidence_level: 'VERY_LOW' };
}

const results = inputData.map((item, index) => {
  const data = item.json;

  console.log(`\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━`);
  console.log(`📋 Symbol ${index + 1}/${inputData.length}: ${data.symbol}`);
  console.log(`━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━`);

  // Calculate R/R score
  const rrScoreResult = calculateRRScore(data);

  // =====================================================
  // [T-07] Inject rr_bonus into total_score so the bonus actually drives ranking.
  //
  // Previously rr_bonus was added only to the side metric risk_reward_score, which
  // is informational and never feeds Hard Filters Enforcer or SIGNAL RANKING. As
  // a result, a marginal-score signal with exceptional R/R (e.g. total_score 63
  // + rr_bonus +10) failed the Tier-2 dynamic floor of 65-68 despite being one
  // of the highest-R/R candidates in the cycle — an obvious mis-prioritisation
  // of sustainability quality.
  //
  // Fix: total_score = min(100, total_score_pre_rr_bonus + rr_bonus). Reclassify
  // signal_strength so downstream classification reflects the bonused score.
  // Hard Filters dynamic floor, SIGNAL RANKING sort, and Telegram strength
  // labels all observe the same value.
  //
  // Note on ordering: VOLUME PENALTY APPLICATOR (now a passthrough post W-02) ran
  // before TP-SL Calculator → R/R Filter → R/R Score Output. Bonus is applied
  // HERE, downstream of all volume/penalty math, so there is no interaction
  // with the volume_score weighting.
  // =====================================================
  const rrBonus = parseFloat(data.rr_bonus || 0);
  const totalScorePreBonus = parseFloat(data.total_score || 0);
  const totalScoreWithBonus = Math.min(100, totalScorePreBonus + rrBonus);
  const reclass = classifyByScore(totalScoreWithBonus);

  if (rrBonus > 0) {
    console.log(`  [T-07] total_score injection: ${totalScorePreBonus.toFixed(2)} + ${rrBonus} = ${totalScoreWithBonus.toFixed(2)} | strength: ${data.signal_strength} → ${reclass.signal_strength}`);
  }

  return {
    json: {
      // ═══════════════════════════════════════════════
      // PASS-THROUGH ALL EXISTING DATA
      // ═══════════════════════════════════════════════
      ...data,

      // ═══════════════════════════════════════════════
      // RISK/REWARD SCORE (SUSTAINABILITY METRIC)
      // ═══════════════════════════════════════════════
      risk_reward_score: rrScoreResult.risk_reward_score,

      // ═══════════════════════════════════════════════
      // [T-07] BONUSED TOTAL SCORE + RECLASSIFIED STRENGTH
      // ═══════════════════════════════════════════════
      total_score: parseFloat(totalScoreWithBonus.toFixed(2)),
      total_score_pre_rr_bonus: parseFloat(totalScorePreBonus.toFixed(2)),
      signal_strength: reclass.signal_strength,
      confidence_level: reclass.confidence_level,
      rr_bonus_applied_to_total: rrBonus,

      // ═══════════════════════════════════════════════
      // SCORE BREAKDOWN (FOR AUDIT)
      // ═══════════════════════════════════════════════
      rr_score_components: rrScoreResult.score_components,
      rr_scoring_weights: rrScoreResult.scoring_weights,

      // ═══════════════════════════════════════════════
      // TIMESTAMPS
      // ═══════════════════════════════════════════════
      rr_score_calculated_at: new Date().toISOString()
    }
  };
});

