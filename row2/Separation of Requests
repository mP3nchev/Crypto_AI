// Filter INCOMPLETE symbols before TAAPI
const validItems = $input.all().filter(item => !item.json.exclude_from_taapi);

// =====================================================
// TAAPI SECRET KEY -- [A-01] sourced from N8N env, never inline
// Configure: N8N -> Settings -> Environment Variables -> TAAPI_SECRET_KEY
// Node halts explicitly when the variable is absent or empty.
// =====================================================
const SECRET_KEY = $env.TAAPI_SECRET_KEY;
if (!SECRET_KEY) {
  throw new Error('CRITICAL [A-01]: TAAPI_SECRET_KEY env var is missing or empty. Set it in N8N environment variables before running this workflow.');
}

// =====================================================
// INPUT VALIDATION
// =====================================================
const inputItems = $input.all();

console.log('=== SEPARATION OF REQUESTS START ===');
console.log(`Input items received: ${inputItems ? inputItems.length : 0}`);

if (!inputItems || inputItems.length === 0) {
  console.error('CRITICAL ERROR: No input items received from previous node');
  return [{
    json: {
      error: 'No input items',
      message: 'Previous node returned empty data',
      timestamp: new Date().toISOString()
    }
  }];
}

// =====================================================
// CYCLE TRACKING -- A-02 FIX: read from upstream, never regenerate
// =====================================================
const scan_cycle_id   = inputItems[0].json.scan_cycle_id;
const cycle_timestamp = inputItems[0].json.cycle_timestamp;

if (!scan_cycle_id) {
  throw new Error('CRITICAL [A-02]: scan_cycle_id missing from Merge SMA items. Upstream propagation broken.');
}

console.log(`Cycle ID: ${scan_cycle_id}`);
console.log(`Cycle timestamp: ${cycle_timestamp}`);

let allRequests = [];
let processedCount = 0;
let skippedCount = 0;

for (let i = 0; i < inputItems.length; i++) {
  const item = inputItems[i];

  if (!item || !item.json) {
    console.error(`Item ${i}: Invalid structure`);
    skippedCount++;
    continue;
  }

  const data = item.json;
  const symbol    = data.symbol;
  const symbol_id = data.symbol_id || data.id;

  if (!symbol)    { console.error(`Item ${i}: Missing symbol`);    skippedCount++; continue; }
  if (!symbol_id) { console.error(`Item ${i}: Missing symbol_id`); skippedCount++; continue; }

  const sma_20 = data.sma_20;
  const original_scan_data = { ...data };

  console.log(`Processing ${i + 1}/${inputItems.length}: ${symbol}`);

  const symbolTaapi = symbol.replace(/USDT$/, '/USDT');

  const constructA = [
    {
      exchange: "binance",
      symbol: symbolTaapi,
      interval: "2h",
      backtrack: 1,
      indicators: [
        { id: `${symbol}_rsi_2h`,     indicator: "rsi",      optInTimePeriod: 14 },
        { id: `${symbol}_macd_2h`,    indicator: "macd",     optInTimePeriod: 14, optInFastKPeriod: 3, optInFastDPeriod: 3 },
        { id: `${symbol}_adx_2h`,     indicator: "adx",      optInTimePeriod: 14 },
        { id: `${symbol}_ema200_2h`,  indicator: "ema",      optInTimePeriod: 200 },
        { id: `${symbol}_stochrsi_2h`,indicator: "stochrsi", optInTimePeriod: 14, optInFastKPeriod: 3, optInFastDPeriod: 3 },
        { id: `${symbol}_willr_2h`,   indicator: "willr",    optInTimePeriod: 14 },
        { id: `${symbol}_mfi_2h`,     indicator: "mfi",      optInTimePeriod: 14 },
        { id: `${symbol}_ema20_2h`,   indicator: "ema",      optInTimePeriod: 20 },
        { id: `${symbol}_ema50_2h`,   indicator: "ema",      optInTimePeriod: 50 }
      ]
    },
    {
      exchange: "binance",
      symbol: symbolTaapi,
      interval: "1h",
      backtrack: 1,
      indicators: [
        { id: `${symbol}_rsi_1h`,     indicator: "rsi",      optInTimePeriod: 14 },
        { id: `${symbol}_macd_1h`,    indicator: "macd" },
        { id: `${symbol}_vwap_1h`,    indicator: "vwap" },
        { id: `${symbol}_obv_1h`,     indicator: "obv" },
        { id: `${symbol}_atr_1h`,     indicator: "atr",      optInTimePeriod: 14 },
        { id: `${symbol}_bbw_1h`,     indicator: "bbw" },
        { id: `${symbol}_ema20_1h`,   indicator: "ema",      optInTimePeriod: 20 },
        { id: `${symbol}_ema50_1h`,   indicator: "ema",      optInTimePeriod: 50 },
        { id: `${symbol}_stochrsi_1h`,indicator: "stochrsi" }
      ]
    },
    {
      exchange: "binance",
      symbol: symbolTaapi,
      interval: "15m",
      backtrack: 1,
      indicators: [
        { id: `${symbol}_willr_15m`, indicator: "willr" },
        { id: `${symbol}_rsi_15m`,   indicator: "rsi",  optInTimePeriod: 14 }
      ]
    }
  ];

  allRequests.push({
    json: {
      secret: SECRET_KEY,
      construct: constructA,
      symbol: symbol,
      symbol_id: symbol_id,
      cycle_timestamp: cycle_timestamp,
      scan_cycle_id: scan_cycle_id,
      request_type: 'A',
      sma_20: sma_20,
      original_scan_data: original_scan_data
    }
  });

  processedCount++;
}

console.log(`\nProcessed: ${processedCount} | Skipped: ${skippedCount} | Requests: ${allRequests.length}`);

if (allRequests.length === 0) {
  console.error('CRITICAL: No valid requests created');
  return [{ json: { error: 'No valid symbols processed', timestamp: new Date().toISOString() } }];
}

return allRequests;
