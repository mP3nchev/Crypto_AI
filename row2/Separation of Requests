// Filter INCOMPLETE symbols before TAAPI
const validItems = $input.all().filter(item => !item.json.exclude_from_taapi);

// =====================================================
// TAAPI v2 MIGRATION                                       (was v1: api.taapi.io)
//
// !! v2 has NO 2h timeframe (supported: 1m 5m 15m 1h 4h 1d 1w) and v1 is not available.
//    TAAPI is therefore asked only for 1h (9 indicators) and 15m (2 indicators). The 9 two-hour
//    indicators are computed from Binance candles by the node "2H INDICATOR CALCULATOR".
//
// v2 API (verified on the user's account with a live test):
//   POST https://v2.taapi.io/bulk
//   Header   Authorization: Bearer <API KEY>      <- NOT in the body any more
//   Body     { "constructs": [ { id, exchange, symbol, timeframe, indicators: [ { id, indicator, period?, backtrack? } ] } ] }
//   Response { "<construct id>": { "<indicator id>": { value:[..] | valueMACD:[..] | valueFastK:[..], timestamp:[..] } } }
//
// The API key must NOT be in this code or in the node text. Create an N8N credential:
//   Credentials -> New -> "Header Auth"   Name: Authorization   Value: Bearer <API KEY>
// and select it in the HTTP POST TAAPI BULK node (Authentication -> Generic -> Header Auth).
//
// HTTP POST TAAPI BULK node:
//   Method POST · URL https://v2.taapi.io/bulk · Body: JSON · Specify Body: Using JSON
//   JSON Body (expression):   {{ JSON.stringify({ constructs: $json.constructs }) }}
//
// Construct / indicator ids are what TAAPI RESPONSE PROCESSOR reads back:
//   construct id = "<SYMBOL>_<timeframe>"   e.g. BTCUSDT_2h      indicator id = e.g. rsi, macd, ema200
// Keep the ids in sync with TAAPI RESPONSE PROCESSOR (scripts/test_taapi_v2_adapter.js checks it).
// =====================================================

// =====================================================
// INPUT VALIDATION
// =====================================================
const inputItems = $input.all();

console.log('=== SEPARATION OF REQUESTS START ===');
console.log(`Input items received: ${inputItems ? inputItems.length : 0}`);

if (!inputItems || inputItems.length === 0) {
  console.error('CRITICAL ERROR: No input items received from previous node');
  return [{
    json: {
      error: 'No input items',
      message: 'Previous node returned empty data',
      timestamp: new Date().toISOString()
    }
  }];
}

// =====================================================
// CYCLE TRACKING -- A-02 FIX: read from upstream, never regenerate
// =====================================================
const scan_cycle_id   = inputItems[0].json.scan_cycle_id;
const cycle_timestamp = inputItems[0].json.cycle_timestamp;

if (!scan_cycle_id) {
  throw new Error('CRITICAL [A-02]: scan_cycle_id missing from Merge SMA items. Upstream propagation broken.');
}

console.log(`Cycle ID: ${scan_cycle_id}`);
console.log(`Cycle timestamp: ${cycle_timestamp}`);

// backtrack: 1 = last CLOSED candle. If the live test shows it must sit on the construct, not the
// indicator, only the `ind` helper and one line in each construct need to move.
const BACKTRACK = 1;

let allRequests = [];
let processedCount = 0;
let skippedCount = 0;

for (let i = 0; i < inputItems.length; i++) {
  const item = inputItems[i];

  if (!item || !item.json) {
    console.error(`Item ${i}: Invalid structure`);
    skippedCount++;
    continue;
  }

  const data = item.json;
  const symbol    = data.symbol;
  const symbol_id = data.symbol_id || data.id;

  if (!symbol)    { console.error(`Item ${i}: Missing symbol`);    skippedCount++; continue; }
  if (!symbol_id) { console.error(`Item ${i}: Missing symbol_id`); skippedCount++; continue; }

  const sma_20 = data.sma_20;
  const original_scan_data = { ...data };

  console.log(`Processing ${i + 1}/${inputItems.length}: ${symbol}`);

  // v2 symbol format has no slash: BTCUSDT (verified live)
  const symbolTaapi = symbol;

  // `period` replaces v1 "optInTimePeriod". backtrack:1 = evaluate the last CLOSED candle
  // (same meaning as v1). macd / vwap / obv / bbw / stochrsi use TAAPI defaults, exactly as the
  // v1 request effectively did (the v1 2h macd extra params did not apply to macd).
  const ind = (id, indicator, period) => {
    const o = { id, indicator, backtrack: BACKTRACK };
    if (period !== undefined) o.period = period;
    return o;
  };

  const constructs = [
    {
      id: `${symbol}_1h`, exchange: "binance", symbol: symbolTaapi, timeframe: "1h",
      indicators: [
        ind('rsi', 'rsi', 14),
        ind('macd', 'macd'),
        ind('vwap', 'vwap'),
        ind('obv', 'obv'),
        ind('atr', 'atr', 14),
        ind('bbw', 'bbw'),
        ind('ema20', 'ema', 20),
        ind('ema50', 'ema', 50),
        ind('stochrsi', 'stochrsi')
      ]
    },
    {
      id: `${symbol}_15m`, exchange: "binance", symbol: symbolTaapi, timeframe: "15m",
      indicators: [
        ind('willr', 'willr', 14),
        ind('rsi', 'rsi', 14)
      ]
    }
  ];

  allRequests.push({
    json: {
      // API key is NOT passed here — it lives in the N8N credential (Header Auth)
      constructs: constructs,
      symbol: symbol,
      symbol_id: symbol_id,
      cycle_timestamp: cycle_timestamp,
      scan_cycle_id: scan_cycle_id,
      sma_20: sma_20,
      original_scan_data: original_scan_data
    }
  });

  processedCount++;
}

console.log(`\nProcessed: ${processedCount} | Skipped: ${skippedCount} | Requests: ${allRequests.length}`);

if (allRequests.length === 0) {
  console.error('CRITICAL: No valid requests created');
  return [{ json: { error: 'No valid symbols processed', timestamp: new Date().toISOString() } }];
}

return allRequests;
