// =====================================================
// TAAPI RESPONSE PROCESSOR — v2 (20 INDICATORS + TIME-SERIES)
// Mode: Run Once for All Items
//
// TAAPI v2 bulk response (one HTTP item per request):
//   { "<SYMBOL>_<tf>": { "<indicator id>": { value:[..] | valueMACD:[..] | valueFastK:[..], timestamp:[..] } } }
// Every result field is an ARRAY (even a single value). With backtrack:1 the array holds the value of
// the last closed candle; if it ever holds more than one element, the LAST one is used (and logged).
//
// OUTPUT is unchanged from the v1 processor: one item per symbol with the same field names
// (rsi_2h, macd_value_2h, stochrsi_k_1h, ...), so "Final post to DB" and everything after it
// need no change. The construct / indicator ids below MUST match "Separation of Requests".
// =====================================================

console.log('=== PROCESSING TAAPI v2 RESPONSES FOR TIME-SERIES ===');

// construct timeframe -> indicator id -> [[scan field, TAAPI result key], ...]
const SPEC = {
  '2h': {
    rsi:      [['rsi_2h', 'value']],
    macd:     [['macd_value_2h', 'valueMACD'], ['macd_signal_2h', 'valueMACDSignal'], ['macd_histogram_2h', 'valueMACDHist']],
    adx:      [['adx_2h', 'value']],
    ema200:   [['ema_200_2h', 'value']],
    stochrsi: [['stochrsi_k_2h', 'valueFastK'], ['stochrsi_d_2h', 'valueFastD']],
    willr:    [['willr_2h', 'value']],
    mfi:      [['mfi_2h', 'value']],
    ema20:    [['ema_20_2h', 'value']],
    ema50:    [['ema_50_2h', 'value']],
  },
  '1h': {
    rsi:      [['rsi_1h', 'value']],
    macd:     [['macd_value_1h', 'valueMACD'], ['macd_signal_1h', 'valueMACDSignal'], ['macd_histogram_1h', 'valueMACDHist']],
    vwap:     [['vwap_1h', 'value']],
    obv:      [['obv_1h', 'value']],
    atr:      [['atr_1h', 'value']],
    bbw:      [['bbw_1h', 'value']],
    ema20:    [['ema_20_1h', 'value']],
    ema50:    [['ema_50_1h', 'value']],
    stochrsi: [['stochrsi_k_1h', 'valueFastK'], ['stochrsi_d_1h', 'valueFastD']],
  },
  '15m': {
    willr:    [['willr_15m', 'value']],
    rsi:      [['rsi_15m', 'value']],
  },
};

// array -> last element; plain number -> itself; anything else -> undefined
function pick(result, key) {
  const v = result ? result[key] : undefined;
  if (Array.isArray(v)) {
    if (v.length > 1) console.log(`  note: ${key} has ${v.length} values, using the last`);
    const x = v[v.length - 1];
    return typeof x === 'number' && Number.isFinite(x) ? x : undefined;
  }
  return typeof v === 'number' && Number.isFinite(v) ? v : undefined;
}

const inputItems = $input.all();
const originalRequests = $('Separation of Requests').all();
console.log(`Responses: ${inputItems.length} | original requests available: ${originalRequests.length}`);

// symbol -> accumulated scan result (a symbol's constructs may arrive in one or several responses)
const bySymbol = new Map();
let httpErrors = 0;

inputItems.forEach((item, index) => {
  const body = item.json;
  if (!body || typeof body !== 'object') { httpErrors++; return; }

  // An error response (HTTP node "continue on fail", or TAAPI error body) has no construct keys.
  if (body.error || body.message) {
    httpErrors++;
    console.log(`item ${index}: TAAPI error: ${JSON.stringify(body.error ?? body.message).slice(0, 200)}`);
  }

  for (const constructId of Object.keys(body)) {
    const res = body[constructId];
    const cut = constructId.lastIndexOf('_');
    if (cut < 1 || !res || typeof res !== 'object' || Array.isArray(res)) continue;

    const symbol = constructId.slice(0, cut);
    const tf = constructId.slice(cut + 1);
    const spec = SPEC[tf];
    if (!spec) { console.log(`item ${index}: unknown construct "${constructId}"`); continue; }

    const original = originalRequests.find((r) => r.json.symbol === symbol);
    if (!original) { console.log(`item ${index}: no original request data for ${symbol}`); continue; }

    if (!bySymbol.has(symbol)) {
      bySymbol.set(symbol, {
        symbol_id: original.json.symbol_id,
        symbol,
        cycle_timestamp: original.json.cycle_timestamp,
        scan_cycle_id: original.json.scan_cycle_id,
        scan_time: new Date().toISOString(),
        scan_date: new Date().toISOString().split('T')[0],
        sma_20: original.json.sma_20,      // CRITICAL: carried over from the original request
      });
    }
    const scanResult = bySymbol.get(symbol);

    for (const [indId, outputs] of Object.entries(spec)) {
      const r = res[indId];
      if (!r || typeof r !== 'object') { console.log(`  ${symbol} ${tf}: indicator "${indId}" missing in response`); continue; }
      if (r.error) { console.log(`  ${symbol} ${tf} ${indId}: ${JSON.stringify(r.error).slice(0, 120)}`); continue; }
      for (const [field, key] of outputs) {
        const v = pick(r, key);
        if (v === undefined) console.log(`  ${symbol} ${tf} ${indId}: no usable "${key}"`);
        else scanResult[field] = v;
      }
    }
    for (const unknownId of Object.keys(res)) {
      if (!(unknownId in spec)) console.log(`  ${symbol} ${tf}: unknown indicator "${unknownId}"`);
    }
  }
});

const allResults = [...bySymbol.values()].map((json) => ({ json }));

console.log(`\n🎯 SUMMARY: ${allResults.length} symbol(s) processed, ${httpErrors} error response(s)`);
console.log(`📅 Cycle: ${allResults[0]?.scan_cycle_id || allResults[0]?.json?.scan_cycle_id || 'N/A'}`);
console.log(`📈 SMA 20 present in ${allResults.filter((r) => r.json.sma_20 !== null && r.json.sma_20 !== undefined).length} results`);

if (allResults.length === 0) {
  console.log('⚠️ WARNING: No results processed!');
  return [{ json: { error: 'No TAAPI data processed' } }];
}

return allResults;
