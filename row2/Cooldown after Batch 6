// COOLDOWN AFTER BATCH 6 — PASSTHROUGH ONLY
// =====================================================
// [A-07] FIX: setTimeout removed.
//
// Root cause: N8N Cloud Code nodes have a ~10s execution timeout.
// A 30s / 20s setTimeout was silently killed before firing — zero
// cooldown occurred, causing TAAPI 429 rate-limit errors from batch 7+.
//
// Correct solution (workflow-level, must be done in N8N editor):
//   1. Add an IF node BEFORE the HTTP POST TAAPI BULK node in the loop.
//   2. Condition A: $('Loop Over Items1').context.currentRunIndex === 6
//      → route through a native N8N Wait node configured for 30 seconds.
//   3. Condition B: $('Loop Over Items1').context.currentRunIndex === 12
//      → route through a native N8N Wait node configured for 20 seconds.
//   4. All other indices → pass through directly to HTTP POST TAAPI BULK.
//
// This Code node is retained as a diagnostic passthrough so the loop
// execution position can be logged without any blocking logic here.
// =====================================================

const batchIndex = $('Loop Over Items1').context.currentRunIndex || 0;
const totalBatches = Math.ceil($('Separation of Requests').all().length / 2);

console.log(`Processing Batch ${batchIndex + 1} of ${totalBatches}`);
console.log(`Cooldown at batch 6 (+30s) and batch 12 (+20s) is handled by the N8N Wait node in the workflow.`);

return $input.all();
