// =====================================================
// GROUP CANDLE RESPONSES v4.0 — A-03 Option A
//
// Reads candles from 4 dedicated interval HTTP nodes.
// Interval identity is GUARANTEED by which node produced the response
// (not by positional matching). Symbol identity is derived from the
// Filter nodes whose order is deterministic (from Bulk Requests Generator).
//
// Prerequisites in N8N:
//   - 4 Filter Code nodes: "Filter 2h Requests", "Filter 1h Requests",
//     "Filter 15m Requests", "Filter 1m Requests"
//   - 4 HTTP nodes: "Binance 2h", "Binance 1h", "Binance 15m", "Binance 1m"
//     Each with "Split Into Items" DISABLED so resp[i].json = full candles array.
//   - Merge node (Append) combining all 4 HTTP outputs → triggers this node.
// =====================================================

const REQUIRED_INTERVALS = ['2h', '1h', '15m', '1m'];

// ── Read filter metadata (symbol ordering) and HTTP responses (candles) ──
// Filter nodes output items in same order as Bulk Requests Generator.
// HTTP nodes process items in that same order (N8N sequential execution).
// With "Split Into Items" OFF: resp[i].json = Binance klines array for symbol i.
const sources = [
  { interval: '2h',  meta: $('Filter 2h Requests').all(),  resp: $('Binance 2h').all()  },
  { interval: '1h',  meta: $('Filter 1h Requests').all(),  resp: $('Binance 1h').all()  },
  { interval: '15m', meta: $('Filter 15m Requests').all(), resp: $('Binance 15m').all() },
  { interval: '1m',  meta: $('Filter 1m Requests').all(),  resp: $('Binance 1m').all()  },
];

const EXPECTED_GAP_MS = { '2h': 7200000, '1h': 3600000, '15m': 900000, '1m': 60000 };

const candleMap = new Map(); // "BTCUSDT|2h" → { symbol, interval, candles[], ... }
let errors = 0;

// =====================================================
// STEP 1: Build candle map from 4 separate interval sources
// =====================================================
for (const { interval, meta, resp } of sources) {
  if (!meta.length) {
    console.error(`❌ [A-03] Filter "${interval}" returned 0 items — upstream issue in Bulk Requests Generator`);
    errors++;
    continue;
  }

  if (meta.length !== resp.length) {
    console.error(
      `❌ [A-03] ${interval}: ${meta.length} filter items but ${resp.length} HTTP responses — ` +
      `request/response count mismatch, possible retry failure`
    );
    errors++;
    // Process up to min(meta, resp) to recover partially
  }

  const count = Math.min(meta.length, resp.length);

  for (let i = 0; i < count; i++) {
    const m       = meta[i].json;
    const raw     = resp[i]?.json;
    const key     = `${m.symbol}|${interval}`;

    // Binance klines format: [[openTime, open, high, low, close, volume, closeTime, ...], ...]
    // With "Split Into Items" OFF on HTTP node, raw IS this array.
    const candles = Array.isArray(raw) ? raw : [];

    if (candles.length === 0) {
      console.error(`❌ Empty candle response for ${key} — Binance returned no data`);
      errors++;
    }

    // ── Candle count validation ──
    if (candles.length !== m.limit) {
      console.error(`❌ COUNT MISMATCH ${key}: expected ${m.limit}, got ${candles.length}`);
      errors++;
    }

    // ── Interval timestamp-gap validation ──
    // Confirms that the candles we received match the expected interval.
    // With Option A this is redundant (interval is guaranteed by node), but kept as safety net.
    if (candles.length >= 2) {
      const t0 = candles[0][0];
      const t1 = candles[1][0];
      const actualGap   = Math.abs(Number(t1) - Number(t0));
      const expectedGap = EXPECTED_GAP_MS[interval];
      if (expectedGap && Math.abs(actualGap - expectedGap) > expectedGap * 0.15) {
        console.error(
          `❌ INTERVAL_GAP_MISMATCH ${key}: expected ~${expectedGap}ms, got ${actualGap}ms`
        );
        errors++;
      }
    }

    candleMap.set(key, {
      symbol:          m.symbol,
      symbol_id:       m.symbol_id,
      interval,
      limit:           m.limit,
      cycle_timestamp: m.cycle_timestamp,
      scan_cycle_id:   m.scan_cycle_id,
      candles,
    });
  }

  console.log(`✅ ${interval}: matched ${count} symbols`);
}

// =====================================================
// STEP 2: Completeness — every symbol must have all 4 intervals
// =====================================================
const symbolIntervals = new Map(); // symbol → Set<interval>

for (const key of candleMap.keys()) {
  const [sym, iv] = key.split('|');
  if (!symbolIntervals.has(sym)) symbolIntervals.set(sym, new Set());
  symbolIntervals.get(sym).add(iv);
}

const incompleteSymbols = new Set();

for (const [sym, found] of symbolIntervals.entries()) {
  const missing = REQUIRED_INTERVALS.filter(iv => !found.has(iv));
  if (missing.length) {
    incompleteSymbols.add(sym);
    console.error(`❌ [INCOMPLETE] ${sym} — missing: ${missing.join(', ')}`);
  }
}

// =====================================================
// STEP 3: Build output (same structure as v3.0)
// =====================================================
const groupedResponses = [];

for (const [key, data] of candleMap.entries()) {
  const incomplete = incompleteSymbols.has(data.symbol);
  groupedResponses.push({
    json: {
      symbol:             data.symbol,
      symbol_id:          data.symbol_id,
      interval:           data.interval,
      limit:              data.limit,
      cycle_timestamp:    data.cycle_timestamp,
      scan_cycle_id:      data.scan_cycle_id,
      candles:            data.candles,
      data_status:        incomplete ? 'INCOMPLETE' : 'COMPLETE',
      exclude_from_taapi: incomplete,
    }
  });
}

// =====================================================
// STEP 4: Summary log
// =====================================================
const byInterval = {};
groupedResponses.forEach(g => {
  byInterval[g.json.interval] = (byInterval[g.json.interval] || 0) + 1;
});

console.log(`\n✅ [Option A] Grouped ${groupedResponses.length} symbol|interval pairs`);
console.log(`⚠️  Incomplete symbols : ${incompleteSymbols.size}`);
console.log(`❌  Total errors       : ${errors}`);
console.log('\n📊 Groups by interval:');
Object.entries(byInterval).forEach(([iv, count]) => console.log(`  ${iv}: ${count}`));

if (incompleteSymbols.size > 0) {
  console.warn(`\n🚫 Excluded from TAAPI: ${[...incompleteSymbols].join(', ')}`);
}

if (errors > 0) {
  console.error(`\n🔴 CRITICAL: ${errors} error(s) — verify HTTP node config (Split Into Items = OFF)`);
}

return groupedResponses;
