// =====================================================
// GROUP CANDLE RESPONSES v4.1 — A-03 Option A
//
// Reads candles from 4 dedicated interval HTTP nodes via cross-node references.
// Works with "Split Into Items" ON (default N8N behaviour): each HTTP response
// item is one individual candle. Symbol i's candles are collected by slice:
//   resp.slice(i * limit, (i + 1) * limit)
//
// Interval identity is GUARANTEED by which HTTP node produced the response.
// Symbol identity is derived from the Filter node order (= Bulk Requests Generator
// order), which N8N preserves when processing items sequentially.
//
// Prerequisites in N8N:
//   - "Filter 2h Requests", "Filter 1h Requests", "Filter 15m Requests", "Filter 1m Requests"
//   - "Binance 2h", "Binance 1h", "Binance 15m", "Binance 1m" (Split Into Items ON or OFF)
//   - Merge1 (Append) combining all 4 → triggers this node.
// =====================================================

const REQUIRED_INTERVALS = ['2h', '1h', '15m', '1m'];
const EXPECTED_GAP_MS    = { '2h': 7200000, '1h': 3600000, '15m': 900000, '1m': 60000 };

// ── Read filter metadata (symbol ordering) and HTTP responses ──
const sources = [
  { interval: '2h',  meta: $('Filter 2h Requests').all(),  resp: $('Binance 2h').all()  },
  { interval: '1h',  meta: $('Filter 1h Requests').all(),  resp: $('Binance 1h').all()  },
  { interval: '15m', meta: $('Filter 15m Requests').all(), resp: $('Binance 15m').all() },
  { interval: '1m',  meta: $('Filter 1m Requests').all(),  resp: $('Binance 1m').all()  },
];

const candleMap = new Map();
let errors = 0;

// =====================================================
// STEP 1: Build candle map — one entry per symbol|interval
// =====================================================
for (const { interval, meta, resp } of sources) {
  if (!meta.length) {
    console.error(`❌ Filter "${interval}" returned 0 items — upstream issue`);
    errors++;
    continue;
  }

  // Detect whether HTTP node has "Split Into Items" ON or OFF.
  // Split ON  → resp.length = meta.length × limit  (individual candles)
  // Split OFF → resp.length = meta.length           (one full array per symbol)
  const limit      = meta[0].json.limit;
  const splitOn    = resp.length === meta.length * limit;
  const splitOff   = resp.length === meta.length;

  if (!splitOn && !splitOff) {
    console.error(
      `❌ ${interval}: unexpected resp count ${resp.length} ` +
      `(expected ${meta.length * limit} for Split ON or ${meta.length} for Split OFF)`
    );
    errors++;
  }

  console.log(`📊 ${interval}: ${meta.length} symbols, ${resp.length} resp items, Split=${splitOn ? 'ON' : 'OFF'}`);

  for (let i = 0; i < meta.length; i++) {
    const m   = meta[i].json;
    const key = `${m.symbol}|${interval}`;

    // ── Collect candles for symbol i ──
    let candles;
    if (splitOn) {
      // Each candle is a separate item: slice [i*limit … (i+1)*limit)
      candles = resp.slice(i * limit, (i + 1) * limit).map(r => r.json);
    } else {
      // Full candles array is in resp[i].json
      const raw = resp[i]?.json;
      candles   = Array.isArray(raw) ? raw : [];
    }

    if (candles.length === 0) {
      console.error(`❌ No candles for ${key}`);
      errors++;
    }

    // ── Candle count validation ──
    if (candles.length !== limit) {
      console.error(`❌ COUNT MISMATCH ${key}: expected ${limit}, got ${candles.length}`);
      errors++;
    }

    // ── Interval timestamp-gap validation ──
    if (candles.length >= 2) {
      const c0 = candles[0];
      const c1 = candles[1];
      const t0 = Array.isArray(c0) ? c0[0] : c0.open_time;
      const t1 = Array.isArray(c1) ? c1[0] : c1.open_time;
      if (t0 !== undefined && t1 !== undefined) {
        const actualGap   = Math.abs(Number(t1) - Number(t0));
        const expectedGap = EXPECTED_GAP_MS[interval];
        if (expectedGap && Math.abs(actualGap - expectedGap) > expectedGap * 0.15) {
          console.error(
            `❌ INTERVAL_GAP_MISMATCH ${key}: expected ~${expectedGap}ms, got ${actualGap}ms`
          );
          errors++;
        }
      }
    }

    candleMap.set(key, {
      symbol:          m.symbol,
      symbol_id:       m.symbol_id,
      interval,
      limit,
      cycle_timestamp: m.cycle_timestamp,
      scan_cycle_id:   m.scan_cycle_id,
      candles,
    });
  }
}

// =====================================================
// STEP 2: Completeness — every symbol must have all 4 intervals
// =====================================================
const symbolIntervals = new Map();
for (const key of candleMap.keys()) {
  const [sym, iv] = key.split('|');
  if (!symbolIntervals.has(sym)) symbolIntervals.set(sym, new Set());
  symbolIntervals.get(sym).add(iv);
}

const incompleteSymbols = new Set();
for (const [sym, found] of symbolIntervals.entries()) {
  const missing = REQUIRED_INTERVALS.filter(iv => !found.has(iv));
  if (missing.length) {
    incompleteSymbols.add(sym);
    console.error(`❌ [INCOMPLETE] ${sym} — missing: ${missing.join(', ')}`);
  }
}

// =====================================================
// STEP 3: Build output (same structure as before)
// =====================================================
const groupedResponses = [];
for (const [key, data] of candleMap.entries()) {
  const incomplete = incompleteSymbols.has(data.symbol);
  groupedResponses.push({
    json: {
      symbol:             data.symbol,
      symbol_id:          data.symbol_id,
      interval:           data.interval,
      limit:              data.limit,
      cycle_timestamp:    data.cycle_timestamp,
      scan_cycle_id:      data.scan_cycle_id,
      candles:            data.candles,
      data_status:        incomplete ? 'INCOMPLETE' : 'COMPLETE',
      exclude_from_taapi: incomplete,
    }
  });
}

// =====================================================
// STEP 4: Summary
// =====================================================
const byInterval = {};
groupedResponses.forEach(g => {
  byInterval[g.json.interval] = (byInterval[g.json.interval] || 0) + 1;
});

console.log(`\n✅ [Option A v4.1] Grouped ${groupedResponses.length} symbol|interval pairs`);
console.log(`⚠️  Incomplete : ${incompleteSymbols.size} symbols`);
console.log(`❌  Errors     : ${errors}`);
console.log('📊 By interval:', Object.entries(byInterval).map(([k, v]) => `${k}:${v}`).join(', '));

if (incompleteSymbols.size > 0) {
  console.warn(`🚫 Excluded from TAAPI: ${[...incompleteSymbols].join(', ')}`);
}
if (errors > 0) {
  console.error(`🔴 CRITICAL: ${errors} error(s) detected`);
}

return groupedResponses;
