// =====================================================
// TREND SCORE CALCULATOR v4.0 - FIXED
// =====================================================
// [T-04] REWRITTEN v4.0 -- three structural bugs fixed:
//   Bug 1: EMA block was nested inside MACD if-block.
//   Bug 2: macdContribution was never added to totalScore.
//   Bug 3: return statement was inside MACD if-block -> returned undefined when MACD=0.
// Each component (ADX, MACD, EMA) is now a fully independent conditional block.
// Final score calculation and return are outside all component blocks.
// =====================================================

console.log('TREND SCORE CALCULATOR v4.0 (FIXED)');

const inputData = $input.all();
console.log(`Calculating trend scores for ${inputData.length} symbols`);

if (inputData.length === 0) {
  console.log('No input data received');
  return [];
}

function getScanData(data) {
  if (data.scan_data) return data.scan_data;
  return data;
}

function safeFloat(value, defaultValue = 0) {
  const parsed = parseFloat(value);
  return isNaN(parsed) ? defaultValue : parsed;
}

function calculateTrendScore(data) {
  let totalScore = 0;
  let maxScore = 0;
  let adxContribution  = 0;
  let macdContribution = 0;
  let emaContribution  = 0;
  let histogramPct     = 0;   // declared at function scope; set inside MACD block

  let trendStrength  = 'WEAK';
  let trendDirection = 'NEUTRAL';

  const scanData = getScanData(data);

  console.log(`\n  Analyzing Trend for ${data.symbol || 'symbol'}`);

  // =====================================================
  // COMPONENT 1: ADX -- TREND STRENGTH (40 points max)
  // =====================================================
  const adx_2h = safeFloat(scanData.adx_2h);

  if (adx_2h > 0) {
    maxScore += 40;
    console.log(`    ADX 2h: ${adx_2h.toFixed(2)}`);

    if (adx_2h >= 25)      { adxContribution = 40; trendStrength = 'STRONG';   console.log(`    Strong Trend (ADX >= 25): +40 points`); }
    else if (adx_2h >= 20) { adxContribution = 30; trendStrength = 'MODERATE'; console.log(`    Moderate Trend (ADX 20-24): +30 points`); }
    else if (adx_2h >= 15) { adxContribution = 20; trendStrength = 'WEAK';     console.log(`    Weak Trend (ADX 15-19): +20 points`); }
    else                   { adxContribution = 10; trendStrength = 'RANGING';  console.log(`    Ranging Market (ADX < 15): +10 points`); }

    totalScore += adxContribution;
  } else {
    console.log(`    ADX data missing`);
  }

  // =====================================================
  // COMPONENT 2: MACD -- DIRECTION & MOMENTUM (30 points max)
  // [T-04 Bug 1+2+3 fix] Independent block -- closes before EMA.
  // totalScore += macdContribution added before block closes.
  // =====================================================
  const macd_value_2h     = safeFloat(scanData.macd_value_2h);
  const macd_signal_2h    = safeFloat(scanData.macd_signal_2h);
  const macd_histogram_2h = safeFloat(scanData.macd_histogram_2h);
  const macd_histogram_1h = safeFloat(scanData.macd_histogram_1h);

  if (macd_value_2h !== 0 || macd_signal_2h !== 0) {
    maxScore += 30;

    const macd_bullish_2h = macd_histogram_2h > 0;
    const macd_bullish_1h = macd_histogram_1h > 0;

    if (macd_bullish_2h)          { trendDirection = 'LONG';  console.log(`    MACD Direction: BULLISH (LONG)`); }
    else if (macd_histogram_2h < 0) { trendDirection = 'SHORT'; console.log(`    MACD Direction: BEARISH (SHORT)`); }

    // A. Multi-timeframe alignment (15 points)
    if (macd_bullish_2h === macd_bullish_1h) {
      macdContribution += 15;
      console.log(`    2h/1h MACD alignment: +15 points`);
    } else {
      macdContribution += 5;
      console.log(`    2h/1h MACD divergence: +5 points`);
    }

    // B. Histogram strength relative to price (15 points)
    const MACD_STRONG_PCT   = { 1: 0.01, 2: 0.05, 3: 0.10 };
    const MACD_MODERATE_PCT = { 1: 0.005, 2: 0.025, 3: 0.05 };
    const symbolTier  = parseInt(data.tier || 2);
    const closePrice  = safeFloat(data.close_price);
    const histStrength2h = Math.abs(macd_histogram_2h);
    histogramPct = closePrice > 0 ? (histStrength2h / closePrice) * 100 : 0;

    const strongThreshold   = MACD_STRONG_PCT[symbolTier]   || MACD_STRONG_PCT[2];
    const moderateThreshold = MACD_MODERATE_PCT[symbolTier] || MACD_MODERATE_PCT[2];

    if (histogramPct >= strongThreshold) {
      macdContribution += 15;
      console.log(`    Strong MACD momentum: ${histogramPct.toFixed(4)}% >= ${strongThreshold}% (Tier ${symbolTier}): +15 pts`);
    } else if (histogramPct >= moderateThreshold) {
      macdContribution += 10;
      console.log(`    Moderate MACD momentum: ${histogramPct.toFixed(4)}% >= ${moderateThreshold}% (Tier ${symbolTier}): +10 pts`);
    } else {
      macdContribution += 5;
      console.log(`    Weak MACD momentum: ${histogramPct.toFixed(4)}% < ${moderateThreshold}% (Tier ${symbolTier}): +5 pts`);
    }

    // [T-04 Bug 2 fix] Add MACD contribution to totalScore -- was silently dropped before v4.0
    totalScore += macdContribution;
  } else {
    console.log(`    MACD data missing`);
  }
  // [T-04 Bug 1 fix] MACD block closes here -- EMA is the next independent block

  // =====================================================
  // COMPONENT 3: EMA ALIGNMENT -- CONFIRMATION (30 points max)
  // [T-04 Bug 1 fix] Independent block -- executes regardless of MACD availability
  // =====================================================
  const ema_20_2h  = safeFloat(scanData.ema_20_2h);
  const ema_50_2h  = safeFloat(scanData.ema_50_2h);
  const ema_200_2h = safeFloat(scanData.ema_200_2h);
  const close_price = safeFloat(data.close_price);

  if (ema_20_2h > 0 && ema_50_2h > 0 && close_price > 0) {
    maxScore += 30;

    const bullish_alignment = close_price > ema_20_2h && ema_20_2h > ema_50_2h;
    const bearish_alignment = close_price < ema_20_2h && ema_20_2h < ema_50_2h;

    if (bullish_alignment) {
      emaContribution = 30;
      console.log(`    Perfect Bullish EMA Alignment: +30 points`);
      if (trendDirection === 'NEUTRAL') { trendDirection = 'LONG'; }
      if (trendDirection === 'SHORT')   { emaContribution = 15; console.log(`    CONFLICT: MACD=SHORT, EMA=LONG -> Reducing confidence`); }
    } else if (bearish_alignment) {
      emaContribution = 30;
      console.log(`    Perfect Bearish EMA Alignment: +30 points`);
      if (trendDirection === 'NEUTRAL') { trendDirection = 'SHORT'; }
      if (trendDirection === 'LONG')    { emaContribution = 15;  console.log(`    CONFLICT: MACD=LONG, EMA=SHORT -> Reducing confidence`); }
    } else if (close_price > ema_20_2h) {
      emaContribution = 15;
      console.log(`    Partial Bullish (Price > EMA20): +15 points`);
    } else if (close_price < ema_20_2h) {
      emaContribution = 15;
      console.log(`    Partial Bearish (Price < EMA20): +15 points`);
    } else {
      emaContribution = 5;
      console.log(`    No clear EMA trend: +5 points`);
    }
    totalScore += emaContribution;
  } else {
    console.log(`    EMA data incomplete`);
  }

  // =====================================================
  // GUARD: all components absent
  // =====================================================
  if (maxScore === 0) {
    console.log(`    No valid indicator data -- returning zero score`);
    return {
      score: 0,
      components: { adx_contribution: 0, macd_contribution: 0, ema_contribution: 0, trend_score_legacy: 0, trend_score_v4: 0 },
      trend_strength: 'WEAK', trend_direction: 'NEUTRAL',
      signal_direction: 'NEUTRAL', macd_histogram_pct: 0
    };
  }

  // =====================================================
  // CALCULATE FINAL SCORE -- outside all component blocks [T-04 Bug 3 fix]
  // =====================================================
  const finalScore  = Math.round((totalScore / maxScore) * 100);

  // [T-04 calibration] legacy = ADX+EMA only, matches pre-v4.0 behaviour (MACD was silently 0)
  const legacyScore = Math.round((adxContribution + emaContribution) / maxScore * 100);

  console.log(`    ADX: ${adxContribution}/40 | MACD: ${macdContribution}/30 | EMA: ${emaContribution}/30`);
  console.log(`    Total: ${totalScore}/${maxScore} -> ${finalScore}/100 (legacy: ${legacyScore}/100)`);
  console.log(`    Direction: ${trendDirection} | Strength: ${trendStrength}`);

  return {
    score: finalScore,
    components: {
      adx_contribution:  adxContribution,
      macd_contribution: macdContribution,
      ema_contribution:  emaContribution,
      trend_score_legacy: legacyScore,  // pre-v4.0 baseline (ADX+EMA only)
      trend_score_v4:     finalScore    // authoritative post-fix score
    },
    trend_strength:     trendStrength,
    trend_direction:    trendDirection,
    signal_direction:   trendDirection,
    macd_histogram_pct: histogramPct
  };
}

// =====================================================
// PROCESS EACH SYMBOL
// =====================================================
const results = inputData.map((item, index) => {
  const data = item.json;
  console.log(`\nSymbol ${index + 1}/${inputData.length}: ${data.symbol}`);
  const trend = calculateTrendScore(data);
  
  return {
    json: {
      ...data,
      trend_score:      trend.score,
      trend_components: trend.components,
      trend_strength:   trend.trend_strength,
      trend_direction:  trend.trend_direction,
      macd_histogram_pct: trend.macd_histogram_pct,
      trend_scored_at:  new Date().toISOString(),
      trend_calculator_version: 'v4.0 (T-04 Fixed)'
    }
  };
});

const avgScore = results.reduce((sum, r) => sum + (r.json.trend_score || 0), 0) / results.length;
console.log(`\nTrend scoring complete for ${results.length} symbols. Avg: ${avgScore.toFixed(1)}/100`);

return results;
