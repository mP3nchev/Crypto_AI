// =====================================================
// NODE 3: VOLUME PENALTY APPLICATOR v3.0 — PASSTHROUGH (W-02)
// =====================================================
// [W-02] Volume double-penalty resolved at source: VOLUME SCORE CALCULATOR now
// integrates the ratio multiplier directly into volume_score, which is then
// weighted (15-20%) by SCORE AGGREGATOR. The previous subtract of volume_penalty
// from total_score here caused the same low-ratio observation to suppress the
// signal twice.
//
// This node is RETAINED in the workflow (removal would require editing the N8N
// canvas) but converted to a metadata-only passthrough:
//   - No subtract from total_score
//   - No reclassification of signal_strength (already correct from Aggregator)
//   - Audit trail preserved (volume_penalty value, volume_status, ratio_multiplier)
//
// volume_penalty arriving here is 0 (set by Volume Score Calculator post-fix).
// If a legacy upstream still emits a non-zero penalty, it is logged but not
// applied — fail-loud rather than re-introduce the double-count.
// =====================================================

console.log('⚖️ ═══════════════════════════════════════════════');
console.log('   VOLUME PENALTY APPLICATOR v2.0');
console.log('═══════════════════════════════════════════════');

const inputData = $input.all();
console.log(`📊 Applying volume penalties for ${inputData.length} symbols`);

if (inputData.length === 0) {
  console.log('⚠️ No input data received');
  return [];
}

// =====================================================
// PASSTHROUGH LOGIC (W-02)
// =====================================================
function applyVolumePenalty(data) {
  const originalScore = parseFloat(data.total_score || 0);
  const penalty = parseFloat(data.volume_penalty || 0);
  const ratioMult = parseFloat(data.volume_ratio_multiplier ?? 1);

  console.log(`  Quality Score: ${originalScore.toFixed(2)}/100 (passthrough)`);
  console.log(`  Volume Penalty (legacy field): ${penalty.toFixed(1)} — NOT APPLIED [W-02]`);
  console.log(`  Volume Ratio Multiplier (already in volume_score): ×${ratioMult.toFixed(2)}`);

  if (penalty !== 0) {
    console.warn(`  ⚠️ [W-02] Non-zero volume_penalty (${penalty}) received from upstream — discarded. ` +
                 `Upstream node may be running a stale version. Investigate VOLUME SCORE CALCULATOR.`);
  }

  // Score unchanged; signal_strength was already correctly assigned by SCORE AGGREGATOR.
  return {
    adjusted_score: parseFloat(originalScore.toFixed(2)),
    signal_strength: data.signal_strength,
    confidence_level: data.confidence_level,
    penalty_applied: false,
    penalty_impact: 'NONE',
    was_downgraded: false,
    original_strength: data.signal_strength,
    score_change: 0
  };
}

// =====================================================
// PROCESS EACH SYMBOL
// =====================================================
const results = [];
let unchangedCount = 0;
let downgradedCount = 0;

inputData.forEach((item, index) => {
  const data = item.json;
  
  console.log(`\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━`);
  console.log(`📋 Symbol ${index + 1}/${inputData.length}: ${data.symbol}`);
  console.log(`━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━`);
  
  // Apply penalty
  const penaltyResult = applyVolumePenalty(data);
  
  // Track statistics
  if (penaltyResult.was_downgraded) {
    downgradedCount++;
  } else {
    unchangedCount++;
  }
  
  // Build output
  results.push({
    json: {
      // ═══════════════════════════════════════════════
      // PASS-THROUGH ALL EXISTING DATA
      // ═══════════════════════════════════════════════
      ...data,
      
      // ═══════════════════════════════════════════════
      // UPDATED SCORE (AFTER PENALTY)
      // ═══════════════════════════════════════════════
      total_score: penaltyResult.adjusted_score,
      score_before_penalty: parseFloat(data.total_score || 0),
      
      // ═══════════════════════════════════════════════
      // UPDATED CLASSIFICATION
      // ═══════════════════════════════════════════════
      signal_strength: penaltyResult.signal_strength,
      confidence_level: penaltyResult.confidence_level,
      
      // ═══════════════════════════════════════════════
      // PENALTY METADATA
      // ═══════════════════════════════════════════════
      penalty_applied: penaltyResult.penalty_applied,
      penalty_impact: penaltyResult.penalty_impact,
      was_downgraded: penaltyResult.was_downgraded,
      original_signal_strength: penaltyResult.original_strength,
      score_change_from_penalty: penaltyResult.score_change,
      
      // ═══════════════════════════════════════════════
      // TIMESTAMPS
      // ═══════════════════════════════════════════════
      penalty_applied_at: new Date().toISOString()
    }
  });
});

// =====================================================
// SUMMARY STATISTICS
// =====================================================
console.log(`\n\n╔════════════════════════════════════════════════════╗`);
console.log(`║     VOLUME PENALTY APPLICATION SUMMARY            ║`);
console.log(`╚════════════════════════════════════════════════════╝`);
console.log(`📊 Total Symbols Processed: ${results.length}`);

console.log(`\n⚡ Penalty Impact:`);
console.log(`  ➡️ Unchanged: ${unchangedCount} symbols`);
console.log(`  📉 Downgraded: ${downgradedCount} symbols`);

// Final signal distribution
const finalDistribution = {
  VERY_STRONG: results.filter(r => r.json.signal_strength === 'VERY_STRONG').length,
  STRONG: results.filter(r => r.json.signal_strength === 'STRONG').length,
  MEDIUM: results.filter(r => r.json.signal_strength === 'MEDIUM').length,
  WEAK: results.filter(r => r.json.signal_strength === 'WEAK').length,
  VERY_WEAK: results.filter(r => r.json.signal_strength === 'VERY_WEAK').length
};

console.log(`\n🎖️ Final Signal Distribution (After Penalties):`);
Object.entries(finalDistribution).forEach(([strength, count]) => {
  if (count > 0) {
    console.log(`  ${strength}: ${count} signals`);
  }
});

// Penalty impact breakdown
const impactBreakdown = {
  NONE: results.filter(r => r.json.penalty_impact === 'NONE').length,
  LOW: results.filter(r => r.json.penalty_impact === 'LOW').length,
  MEDIUM: results.filter(r => r.json.penalty_impact === 'MEDIUM').length,
  HIGH: results.filter(r => r.json.penalty_impact === 'HIGH').length
};

console.log(`\n📊 Penalty Impact Distribution:`);
Object.entries(impactBreakdown).forEach(([impact, count]) => {
  if (count > 0) {
    console.log(`  ${impact}: ${count} symbols`);
  }
});

// Average score change
const avgScoreChange = results.reduce((sum, r) => sum + Math.abs(r.json.score_change_from_penalty || 0), 0) / results.length;
console.log(`\n📉 Average Score Change: ${avgScoreChange.toFixed(2)} points`);

// Top penalties
console.log(`\n🔻 Top 3 Penalties Applied:`);
results
  .filter(r => r.json.penalty_applied)
  .sort((a, b) => Math.abs(b.json.score_change_from_penalty) - Math.abs(a.json.score_change_from_penalty))
  .slice(0, 3)
  .forEach((r, i) => {
    console.log(`  ${i + 1}. ${r.json.symbol}: -${Math.abs(r.json.score_change_from_penalty).toFixed(1)} points (${r.json.original_signal_strength} → ${r.json.signal_strength})`);
  });

console.log(`\n✅ Volume Penalty Application Complete`);
console.log(`📤 Passing ${results.length} signals to TP/SL Calculator`);

// =====================================================
// RETURN OUTPUT
// =====================================================
return results;
