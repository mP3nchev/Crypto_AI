// =====================================================
// NODE 1: SCORE AGGREGATOR - PURE QUALITY CALCULATOR
// =====================================================
// Input1: ADX Market Condition + Adaptive Weights
// Input2: Momentum Score
// Input3: Volatility Score
// Input4: Trend Score
// Input5: Volume Score + Price Action
// =====================================================

console.log('SCORE AGGREGATOR v2.0 - QUALITY CALCULATOR');

const inputData = $input.all();
console.log(`Processing ${inputData.length} merged signals`);

if (inputData.length === 0) {
  console.log('No input data received');
  return [];
}

// =====================================================
// [T-02] MOMENTUM DIRECTION CORRECTION MULTIPLIER
// Applied post-weighting to penalize momentum score when it conflicts with signal direction.
// SHORT: high momentum (bullish indicator) is contradictory -- penalize progressively.
// LONG:  low momentum (bearish indicator) is contradictory -- mirror logic.
// Raw momentum_score is NOT modified; only the weighted contribution is adjusted.
// =====================================================
function getMomentumCorrectionMultiplier(score, direction) {
  if (direction === 'SHORT') {
    if (score >= 75) return 0.35;
    if (score >= 60) return 0.55;
    if (score >= 50) return 0.80;
    return 1.0;
  }
  if (direction === 'LONG') {
    if (score <= 25) return 0.35;
    if (score <= 40) return 0.55;
    if (score <= 50) return 0.80;
    return 1.0;
  }
  return 1.0; // NEUTRAL -- no correction
}

// =====================================================
// [T-03] VOLUME (OBV) DIRECTION CORRECTION MULTIPLIER
// OBV is direction-aware: rising OBV confirms bullish, not bearish.
// When direction=SHORT but OBV is strongly positive, reduce the volume contribution.
// Ceiling 0.75 -- avoids over-penalizing the direction-neutral 70/100 volume points.
// =====================================================
function getVolumeCorrectionMultiplier(score, direction, obv) {
  if (direction === 'SHORT') {
    if (obv > 1000000)  return 0.75;
    if (obv > 500000)   return 0.85;
    return 1.0;
  }
  if (direction === 'LONG') {
    if (obv < -1000000) return 0.75;
    if (obv < -500000)  return 0.85;
    return 1.0;
  }
  return 1.0; // NEUTRAL -- no correction
}

// =====================================================
// PROCESS EACH SYMBOL
// =====================================================
const results = inputData.map((item, index) => {
  const data = item.json;
  
  console.log(`\nSignal ${index + 1}/${inputData.length}: ${data.symbol}`);
  
  // =====================================================
  // STEP 1: EXTRACT COMPONENT SCORES (0-100)
  // =====================================================
  const momentumScore    = parseFloat(data.momentum_score || 0);
  const trendScore       = parseFloat(data.trend_score || 0);
  const volatilityScore  = parseFloat(data.volatility_score || 0);
  const volumeScore      = parseFloat(data.volume_score || 0);
  const priceActionScore = parseFloat(data.price_action_score || 0);
  
  console.log(`  Momentum: ${momentumScore.toFixed(1)} | Trend: ${trendScore.toFixed(1)} | Vol: ${volatilityScore.toFixed(1)} | Volume: ${volumeScore.toFixed(1)} | PA: ${priceActionScore.toFixed(1)}`);
  
  // =====================================================
  // STEP 2: EXTRACT ADAPTIVE WEIGHTS (RAW)
  // =====================================================
  const marketCondition = data.market_condition;
  const adxStrength = data.adx_strength;

  // [A-10] FAIL-FAST: 'WEIGHTS_MISSING' sentinel means the ADX/Adaptive Weights branch
  // (input1 in the Merge node) produced no output this cycle. Scoring with any default
  // weights would produce a silent, invalid result -- exclude the signal entirely.
  if (marketCondition === 'WEIGHTS_MISSING' || adxStrength === 'WEIGHTS_MISSING') {
    console.error(`[A-10] WEIGHTS_MISSING for ${data.symbol} -- ADX/Adaptive Weights branch returned no data. Signal excluded.`);
    return null;
  }

  const rawWeights = {
    momentum:     parseFloat(data.weight_momentum),
    trend:        parseFloat(data.weight_trend),
    volatility:   parseFloat(data.weight_volatility),
    volume:       parseFloat(data.weight_volume),
    price_action: parseFloat(data.weight_price_action)
  };

  // [A-10] Guard: reject any signal whose weight fields are null, NaN, or the -1 sentinel.
  const hasInvalidWeights = Object.values(rawWeights).some(w => w === null || isNaN(w) || w < 0);
  if (hasInvalidWeights) {
    console.error(`[A-10] INVALID WEIGHTS for ${data.symbol} -- one or more weight fields are null, NaN, or negative. Signal excluded.`);
    return null;
  }

  console.log(`  Market: ${marketCondition} (ADX: ${adxStrength})`);
  
  // =====================================================
  // STEP 3: NORMALIZE WEIGHTS TO 100%
  // =====================================================
  const totalRawWeight = Object.values(rawWeights).reduce((sum, w) => sum + w, 0);
  const weights = {};
  Object.keys(rawWeights).forEach(key => {
    weights[key] = rawWeights[key] / totalRawWeight;
  });
  
  // =====================================================
  // STEP 4: CALCULATE WEIGHTED COMPONENTS
  // =====================================================
  const signalDir = data.trend_direction || 'NEUTRAL';
  const obv1h     = parseFloat(data.obv_1h || 0);

  // [T-02] Momentum correction: penalize bullish momentum on SHORT signals (and vice versa)
  const momentumCorrMult = getMomentumCorrectionMultiplier(momentumScore, signalDir);
  // [T-03] Volume correction: penalize rising OBV on SHORT signals (and vice versa)
  const volumeCorrMult   = getVolumeCorrectionMultiplier(volumeScore, signalDir, obv1h);

  const weightedMomentum    = momentumScore    * weights.momentum    * momentumCorrMult;
  const weightedTrend       = trendScore       * weights.trend;
  const weightedVolatility  = volatilityScore  * weights.volatility;
  const weightedVolume      = volumeScore      * weights.volume      * volumeCorrMult;
  const weightedPriceAction = priceActionScore * weights.price_action;

  console.log(`  Momentum: ${momentumScore.toFixed(1)} x ${weights.momentum.toFixed(3)} x ${momentumCorrMult.toFixed(2)} (T-02) = ${weightedMomentum.toFixed(2)}`);
  console.log(`  Trend:    ${trendScore.toFixed(1)} x ${weights.trend.toFixed(3)} = ${weightedTrend.toFixed(2)}`);
  console.log(`  Volume:   ${volumeScore.toFixed(1)} x ${weights.volume.toFixed(3)} x ${volumeCorrMult.toFixed(2)} (T-03) = ${weightedVolume.toFixed(2)}`);

  // =====================================================
  // STEP 5: CALCULATE TOTAL QUALITY SCORE
  // =====================================================
  let totalScore = weightedMomentum + weightedTrend + weightedVolatility +
                   weightedVolume + weightedPriceAction;

  // =====================================================
  // STEP 5.5: MOMENTUM-TREND COHERENCE CHECK
  // =====================================================
  const scoreDifference = Math.abs(momentumScore - trendScore);
  let coherencePenalty = 0;
  let coherenceBonus = 0;

  if (scoreDifference > 20) {
    coherencePenalty = -15;
    console.log(`  CONFLICT: Scores differ by >20 pts -> -15 penalty`);
  }
  if (momentumScore >= 50 && trendScore >= 50 && scoreDifference <= 15) {
    coherenceBonus = 5;
    console.log(`  STRONG COHERENCE: Both high & aligned -> +5 bonus`);
  }

  totalScore = Math.max(0, Math.min(100, totalScore + coherencePenalty + coherenceBonus));
  console.log(`  FINAL TOTAL SCORE: ${totalScore.toFixed(2)}/100`);

  // =====================================================
  // STEP 6: DETERMINE SIGNAL STRENGTH & DIRECTION
  // =====================================================
  const signalDirection = data.trend_direction || 'NEUTRAL';
  let signalStrength = 'VERY_WEAK';
  let confidenceLevel = 'VERY_LOW';

  if (totalScore >= 85)      { signalStrength = 'VERY_STRONG'; confidenceLevel = 'VERY_HIGH'; }
  else if (totalScore >= 75) { signalStrength = 'STRONG';      confidenceLevel = 'HIGH'; }
  else if (totalScore >= 65) { signalStrength = 'MEDIUM';      confidenceLevel = 'MEDIUM'; }
  else if (totalScore >= 50) { signalStrength = 'WEAK';        confidenceLevel = 'LOW'; }

  // =====================================================
  // STEP 7: BUILD DETAILED SCORE BREAKDOWN
  // =====================================================
  const scoreBreakdown = {
    raw_scores: { momentum: momentumScore, trend: trendScore, volatility: volatilityScore, volume: volumeScore, price_action: priceActionScore },
    weights: { momentum: weights.momentum, trend: weights.trend, volatility: weights.volatility, volume: weights.volume, price_action: weights.price_action },
    raw_weights: { momentum: rawWeights.momentum, trend: rawWeights.trend, volatility: rawWeights.volatility, volume: rawWeights.volume, price_action: rawWeights.price_action, raw_total: totalRawWeight },
    weighted_scores: {
      momentum:     parseFloat(weightedMomentum.toFixed(2)),
      trend:        parseFloat(weightedTrend.toFixed(2)),
      volatility:   parseFloat(weightedVolatility.toFixed(2)),
      volume:       parseFloat(weightedVolume.toFixed(2)),
      price_action: parseFloat(weightedPriceAction.toFixed(2))
    },
    // Direction correction multipliers (T-02 + T-03 audit trail)
    momentum_correction_multiplier: momentumCorrMult,
    volume_correction_multiplier:   volumeCorrMult,
    obv_1h_at_correction:           obv1h,
    total_quality_score: parseFloat(totalScore.toFixed(2))
  };

  return {
    json: {
      symbol_id: data.symbol_id,
      symbol: data.symbol,
      scan_cycle_id: data.scan_cycle_id,
      cycle_timestamp: data.cycle_timestamp,
      total_score: parseFloat(totalScore.toFixed(2)),
      signal_strength: signalStrength,
      signal_direction: signalDirection,
      confidence_level: confidenceLevel,
      momentum_score: momentumScore,
      trend_score: trendScore,
      volatility_score: volatilityScore,
      volume_score: volumeScore,
      price_action_score: priceActionScore,
      weighted_momentum:    parseFloat(weightedMomentum.toFixed(2)),
      weighted_trend:       parseFloat(weightedTrend.toFixed(2)),
      weighted_volatility:  parseFloat(weightedVolatility.toFixed(2)),
      weighted_volume:      parseFloat(weightedVolume.toFixed(2)),
      weighted_price_action: parseFloat(weightedPriceAction.toFixed(2)),
      score_breakdown: scoreBreakdown,
      market_condition: marketCondition,
      adx_strength: adxStrength,
      adx_2h: parseFloat(data.adx_2h || 0),
      applied_weights: weights,
      weights_normalized: true,
      raw_weight_total: parseFloat(totalRawWeight.toFixed(4)),
      tier: data.tier,
      tier_name: data.tier_name,
      rank_position: data.rank_position,
      atr_threshold_low: data.atr_threshold_low,
      atr_threshold_high: data.atr_threshold_high,
      current_atr_1h: data.current_atr_1h,
      atr_percentage_1h: data.atr_percentage_1h,
      volatility_status: data.volatility_status,
      volatility_warning: data.volatility_warning,
      risk_level: data.risk_level,
      max_suggested_leverage: data.max_suggested_leverage,
      current_price: parseFloat(data.close_price || 0),
      close_price: parseFloat(data.close_price || 0),
      open_price: parseFloat(data.open_price || 0),
      high_price: parseFloat(data.high_price || 0),
      low_price: parseFloat(data.low_price || 0),
      latest_1m_price: parseFloat(data.latest_1m_price || data.close_price || 0),
      volume_ratio: data.volume_ratio,
      volume_penalty: parseFloat(data.volume_penalty || 0),
      volume_status: data.volume_status,
      cs_volume: data.cs_volume,
      quote_volume: data.quote_volume,
      candle_volume: data.candle_volume,
      median_volume_1h: parseFloat(data.median_volume_1h || 0),
      median_volume_2h: parseFloat(data.median_volume_2h || 0),
      momentum_components: data.momentum_components,
      trend_components: data.trend_components,
      price_structure: data.price_structure,
      rsi_2h: data.rsi_2h,
      macd_value_2h: data.macd_value_2h,
      macd_signal_2h: data.macd_signal_2h,
      macd_histogram_2h: data.macd_histogram_2h,
      ema_200_2h: data.ema_200_2h,
      ema_20_2h: data.ema_20_2h,
      ema_50_2h: data.ema_50_2h,
      stochrsi_k_2h: data.stochrsi_k_2h,
      stochrsi_d_2h: data.stochrsi_d_2h,
      willr_2h: data.willr_2h,
      mfi_2h: data.mfi_2h,
      rsi_1h: data.rsi_1h,
      atr_1h: data.atr_1h,
      bbw_1h: data.bbw_1h,
      vwap_1h: data.vwap_1h,
      obv_1h: data.obv_1h,
      ema_20_1h: data.ema_20_1h,
      ema_50_1h: data.ema_50_1h,
      stochrsi_k_1h: data.stochrsi_k_1h,
      stochrsi_d_1h: data.stochrsi_d_1h,
      rsi_15m: data.rsi_15m,
      willr_15m: data.willr_15m,
      sma_20: data.sma_20,
      aggregated_at: new Date().toISOString(),
      aggregator_version: 'Quality Calculator v2.1 (Normalized Weights + T-02/T-03 corrections)'
    }
  };
});

console.log(`\nTotal Processed: ${results.length}`);
console.log(`Excluded (null): ${results.filter(r => r === null).length}`);

// [A-10] filter(Boolean) removes nulls from WEIGHTS_MISSING / invalid-weights guard.
return results.filter(Boolean);
