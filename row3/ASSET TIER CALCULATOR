// =====================================================
// BRANCH 1.1: ASSET TIER CALCULATOR
// Определя tier на база rank_position (1-5, 6-15, 16-20)
// Execution Plan v2 — A-09: boundaries corrected for Top 20 context
// =====================================================

console.log('🎯 === ASSET TIER CALCULATOR START ===');

const scanResults = $input.all();
console.log(`Processing ${scanResults.length} symbols for tier classification`);

// =====================================================
// TIER CONFIGURATION — Top 20 boundaries (A-09 fix)
// Previously: 1-10 / 11-40 / 41-150 — Tier 3 was unreachable with 20 symbols
// Now:         1-5  / 6-15  / 16-20  — all three tiers reachable
// =====================================================

const TIER_CONFIG = {
  1: { name: 'Tier 1', rank_range: [1, 5],  atr_low: 3,  atr_high: 6  },
  2: { name: 'Tier 2', rank_range: [6, 15], atr_low: 6,  atr_high: 10 },
  3: { name: 'Tier 3', rank_range: [16, 20], atr_low: 10, atr_high: 15 }
};

// =====================================================
// TIER ASSIGNMENT LOGIC
// =====================================================

function assignTier(rankPosition) {
  const rank = parseInt(rankPosition);
  // Null / NaN → conservative Tier 3 (per A-09 spec)
  if (!rank || isNaN(rank)) return 3;

  if (rank >= 1  && rank <= 5)  return 1;
  if (rank >= 6  && rank <= 15) return 2;
  if (rank >= 16 && rank <= 20) return 3;
  // Any rank outside 1-20 (e.g. future expansion) → Tier 3 conservative fallback
  return 3;
}

// =====================================================
// PROCESS EACH SYMBOL
// =====================================================

const processedResults = scanResults.map(item => {
  const data = item.json;
  const rankPosition = parseInt(data.rank_position) || 999;
  const tier = assignTier(rankPosition);
  const tierConfig = TIER_CONFIG[tier];
  
  console.log(`${data.symbol}: Rank ${rankPosition} → Tier ${tier} (${tierConfig.name})`);
  
  return {
    json: {
      ...data,
      
      // Tier информация (FIXED: Кратки имена)
      tier: tier,
      tier_name: tierConfig.name,  // ✅ Сега е 'Tier 1' вместо 'Tier 1 (Major)'
      atr_threshold_low: tierConfig.atr_low,
      atr_threshold_high: tierConfig.atr_high,
      
      // Metadata
      tier_assigned_at: new Date().toISOString()
    }
  };
});

// =====================================================
// SUMMARY STATISTICS
// =====================================================

const tierCounts = processedResults.reduce((acc, item) => {
  const tier = item.json.tier;
  acc[tier] = (acc[tier] || 0) + 1;
  return acc;
}, {});

console.log(`\n🎯 === TIER CLASSIFICATION SUMMARY ===`);
console.log(`📊 Total symbols processed: ${processedResults.length}`);
console.log(`🥇 Tier 1 (rank 1-5):   ${tierCounts[1] || 0} symbols`);
console.log(`🥈 Tier 2 (rank 6-15):  ${tierCounts[2] || 0} symbols`);
console.log(`🥉 Tier 3 (rank 16-20): ${tierCounts[3] || 0} symbols`);
console.log(`🔄 Cycle: ${processedResults[0]?.json?.scan_cycle_id || 'N/A'}`);

if (processedResults.length === 0) {
  console.error('❌ ERROR: No symbols processed for tier classification');
  return [{
    json: {
      error: 'No symbols processed for tier classification',
      total_input: scanResults.length
    }
  }];
}

console.log('\n✅ Ready for Node 1.2: ATR Volatility Analyzer');

return processedResults;
