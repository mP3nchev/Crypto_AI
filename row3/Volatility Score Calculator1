console.log('📉 === VOLATILITY SCORE CALCULATOR START ===');

const inputData = $input.all();
console.log(`Calculating volatility scores for ${inputData.length} symbols`);

// =====================================================
// HELPERS
// =====================================================

function getScanData(data) {
  if (data.scan_data) return data.scan_data;
  return data;
}

function safeFloat(value, defaultValue = 0) {
  const parsed = parseFloat(value);
  return isNaN(parsed) ? defaultValue : parsed;
}

// =====================================================
// VOLATILITY SCORING LOGIC (TIER-ADJUSTED)
// =====================================================

function calculateVolatilityScore(scanData, tier, atrThresholdLow, atrThresholdHigh) {
  let totalScore = 0;
  let maxScore = 0;
  const components = {};
  
  // ATR Analysis (60 points max)
  const atr_1h = safeFloat(scanData.atr_1h);
  const close_price = safeFloat(scanData.close_price);
  
  // ✅ Initialize volatility status
  let volatilityStatus = 'UNKNOWN';
  let atrPercentage = 0;
  
  if (atr_1h > 0 && close_price > 0) {
    maxScore += 60;
    
    atrPercentage = (atr_1h / close_price) * 100;
    let atrScore = 0;
    
    // Score based on tier-adjusted thresholds
    if (atrPercentage <= atrThresholdLow * 0.5) {
      atrScore = 20;
      volatilityStatus = 'LOW';
    } else if (atrPercentage <= atrThresholdLow) {
      atrScore = 40;
      volatilityStatus = 'NORMAL';
    } else if (atrPercentage <= atrThresholdHigh) {
      atrScore = 60;
      volatilityStatus = 'OPTIMAL';
    } else if (atrPercentage <= atrThresholdHigh * 1.5) {
      atrScore = 30;
      volatilityStatus = 'HIGH';
    } else {
      atrScore = 10;
      volatilityStatus = 'EXTREME';
    }
    
    totalScore += atrScore;
    components.atr_contribution = atrScore;
    components.atr_percentage = atrPercentage;
  }
  
  // Bollinger Bands Width (40 points max) — tier-aware thresholds
  const bbw_1h_raw = safeFloat(scanData.bbw_1h);

  // [B-04] TAAPI returns bbw as a percentage value (e.g. 1.49 = 1.49%).
  // Thresholds below are calibrated in percentage units to match.
  // Dividing by 100 here would produce ratio form (0.0149) which would NOT
  // match the thresholds — keep bbw in percentage and calibrate thresholds
  // accordingly.
  const bbw_1h = bbw_1h_raw;  // percentage form, e.g. 1.49 = 1.49%

  if (bbw_1h > 0) {
    maxScore += 40;
    let bbwScore = 0;

    // =====================================================
    // [T-04] Tier-aware BBW thresholds — calibrated for crypto reality
    //
    // TRADING_PRINCIPLES §3.3 defines GLOBAL BBW thresholds (squeeze < 0.02,
    // optimal 0.02-0.05). Those values were in ratio form (0-1). TAAPI returns
    // bbw_1h in percentage form (0-100), so thresholds are ×100 accordingly.
    // Empirical per-tier ranges:
    //   - BTC/ETH (Tier 1): typical BBW 0.5%-2.5%; squeeze below 0.8%
    //   - Mid-caps (Tier 2): typical BBW 1.5%-6%; squeeze below 1.5%
    //   - Altcoins (Tier 3): typical BBW 3%-15%; squeeze below 3%
    // =====================================================
    const BBW_THRESHOLDS = {
      1: { squeeze: 0.8,  optimal: 1.8,  elevated: 3.0  },  // BTC/ETH — percentage form
      2: { squeeze: 1.5,  optimal: 4.0,  elevated: 7.0  },  // mid-caps
      3: { squeeze: 3.0,  optimal: 7.5,  elevated: 15.0 }   // altcoins
    };
    const bbwT = BBW_THRESHOLDS[tier] || BBW_THRESHOLDS[2];

    if (bbw_1h <= bbwT.squeeze) {
      bbwScore = 25;  // squeeze / LOW
    } else if (bbw_1h <= bbwT.optimal) {
      bbwScore = 40;  // OPTIMAL
    } else if (bbw_1h <= bbwT.elevated) {
      bbwScore = 30;  // elevated
    } else {
      bbwScore = 15;  // extreme
    }

    totalScore += bbwScore;
    components.bbw_contribution = bbwScore;
    components.bbw_tier_thresholds = bbwT;
  }
  
  // [T-09] Fixed-denominator normalization (ATR 60 + BBW 40 = 100).
  // Pre-fix: (totalScore / maxScore) * 100 inflated to 100% when only ATR
  // OR only BBW had data. Missing components now correctly score 0 of max.
  const STRUCTURAL_MAX = 100;
  const finalScore = Math.round((totalScore / STRUCTURAL_MAX) * 100);
  const dataCompletenessPct = Math.round((maxScore / STRUCTURAL_MAX) * 100);

  return {
    score: finalScore,
    status: volatilityStatus,
    components: components,
    atr_percentage: atrPercentage,
    tier_thresholds: {
      low: atrThresholdLow,
      high: atrThresholdHigh
    },
    data_completeness_pct: dataCompletenessPct
  };
}

// =====================================================
// PROCESS EACH SYMBOL
// =====================================================

const results = inputData.map((item, index) => {
  const data = item.json;
  const scanData = getScanData(data);
  
  // ⚠️ Get tier from Supabase response (previous node)
  const tier = parseInt(data.tier || 2);
  
  // =====================================================
  // [A-07] ATR thresholds read from upstream (ASSET TIER CALCULATOR)
  //
  // Previously hardcoded per-tier (T1: 3/6, T2: 6/10, T3: 10/15) — same
  // values also lived in ASSET TIER CALCULATOR's TIER_CONFIG and were
  // written to data.atr_threshold_low/high + asset_tiers DB columns.
  // Two sources of truth meant a calibration change in one node silently
  // diverged from the other; volatility classification would drift from
  // the configured tier policy.
  //
  // Fix: ASSET TIER CALCULATOR is the sole authoritative source. This
  // node reads atr_threshold_low/high from the data object. If they are
  // missing, throw loudly — silent fallback to old hardcoded numbers
  // would mask an upstream pipeline bug (tier insert failure, Restore
  // Full Data mismatch, schema drift in asset_tiers).
  // =====================================================
  const atrLowRaw = data.atr_threshold_low;
  const atrHighRaw = data.atr_threshold_high;

  if (atrLowRaw === undefined || atrLowRaw === null ||
      atrHighRaw === undefined || atrHighRaw === null) {
    throw new Error(
      `[A-07] ${data.symbol}: missing atr_threshold_low/high from upstream ` +
      `(tier=${tier}). ASSET TIER CALCULATOR must populate these — refusing ` +
      `to fall back to hardcoded values which would diverge from tier policy.`
    );
  }

  const atrLow = parseFloat(atrLowRaw);
  const atrHigh = parseFloat(atrHighRaw);

  if (isNaN(atrLow) || isNaN(atrHigh)) {
    throw new Error(
      `[A-07] ${data.symbol}: atr_threshold_low/high are not numeric ` +
      `(low=${atrLowRaw}, high=${atrHighRaw}).`
    );
  }
  
  if (index < 3) {
    console.log(`\n--- ${data.symbol} (Tier ${tier}) ---`);
    console.log(`  ATR Thresholds: ${atrLow}% - ${atrHigh}%`);
  }
  
  const volatility = calculateVolatilityScore(scanData, tier, atrLow, atrHigh);
  
  if (index < 3) {
    console.log(`  Volatility Score: ${volatility.score}/100 (${volatility.status})`);
    console.log(`  ATR Percentage: ${volatility.atr_percentage.toFixed(2)}%`);
  }
  
  return {
    json: {
      ...data, // ✅ Запазваме всички данни
      
      // Add volatility scoring
      volatility_score: volatility.score,
      volatility_status: volatility.status,
      volatility_components: volatility.components,
      atr_percentage: volatility.atr_percentage,
      volatility_data_completeness_pct: volatility.data_completeness_pct,

      // Metadata
      volatility_scored_at: new Date().toISOString()
    }
  };
});

console.log(`\n✅ Volatility scoring complete for ${results.length} symbols`);

const avgScore = results.reduce((sum, r) => sum + (r.json.volatility_score || 0), 0) / results.length;
console.log(`📊 Average Volatility Score: ${avgScore.toFixed(1)}/100`);

// Status distribution
const statusCounts = {
  LOW: results.filter(r => r.json.volatility_status === 'LOW').length,
  NORMAL: results.filter(r => r.json.volatility_status === 'NORMAL').length,
  OPTIMAL: results.filter(r => r.json.volatility_status === 'OPTIMAL').length,
  HIGH: results.filter(r => r.json.volatility_status === 'HIGH').length,
  EXTREME: results.filter(r => r.json.volatility_status === 'EXTREME').length,
  UNKNOWN: results.filter(r => r.json.volatility_status === 'UNKNOWN').length
};

console.log(`\n📊 Volatility Status Distribution:`);
Object.keys(statusCounts).forEach(status => {
  if (statusCounts[status] > 0) {
    console.log(`   ${status}: ${statusCounts[status]}`);
  }
});

console.log('\n✅ Ready for MERGE');

return results;
