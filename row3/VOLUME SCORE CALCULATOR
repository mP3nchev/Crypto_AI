// =====================================================
// NODE 6.1: VOLUME SCORE CALCULATOR v2.1
// =====================================================

console.log('=== VOLUME SCORE CALCULATOR v2.1 START ===');

const inputData = $input.all();
console.log(`Calculating volume scores for ${inputData.length} symbols`);

// =====================================================
// VOLUME SCORING FUNCTION
// =====================================================

function calculateVolumeScore(data) {
  let totalScore = 0;
  let maxScore = 0;
  let penalty = 0;
  let volumeRatio = 0;
  
  console.log(`\n--- ${data.symbol} ---`);
  
  // =====================================================
  // COMPONENT 1: VOLUME TIER + RATIO (50 points max)
  // [T-05] Points re-scaled to fit the 50-point cap. Previously the EXCELLENT
  //        bucket awarded 70 points against maxScore=50, producing volume_score
  //        > 100 after normalization and a weighted contribution that exceeded
  //        the planned 15-20% budget for high-volume assets (favouring BTC/ETH).
  // =====================================================

  const cs_volume = parseFloat(data.cs_volume);
  const candle_volume = parseFloat(data.candle_volume);

  if (!isNaN(cs_volume) && cs_volume > 0) {
    maxScore += 50;

    let volumePoints = 0;
    let volumeStatus = '';

    if (cs_volume >= 1000000000) {
      volumePoints = 50;
      volumeStatus = 'EXCELLENT';
    } else if (cs_volume >= 500000000) {
      volumePoints = 42;
      volumeStatus = 'GOOD';
    } else if (cs_volume >= 100000000) {
      volumePoints = 35;
      volumeStatus = 'MODERATE';
    } else if (cs_volume >= 50000000) {
      volumePoints = 20;
      volumeStatus = 'LOW';
    } else {
      volumePoints = 8;
      volumeStatus = 'VERY_LOW';
    }

    totalScore += volumePoints;
    console.log(`  24h Volume: $${(cs_volume / 1000000).toFixed(2)}M -> ${volumePoints} points (${volumeStatus})`);
    
    // =====================================================
    // VOLUME RATIO CALCULATION — [W-02] integrated multiplier, not separate penalty
    //
    // Previously volume was penalized twice: once via weighted volume_score in
    // Score Aggregator (15-20%) and a second time via volume_penalty subtracted
    // directly from total_score in VOLUME PENALTY APPLICATOR. Result was an
    // over-suppression of legitimate setups at ratios 0.5-0.79 and inconsistent
    // scoring math.
    //
    // Fix: encode the ratio quality as a multiplier on the final volume_score
    // itself. The single weighted contribution (0.15-0.20 × volume_score) now
    // naturally reflects volume suspicion without a duplicate subtract.
    // VOLUME PENALTY APPLICATOR is converted to a metadata passthrough.
    // =====================================================
    if (!isNaN(candle_volume) && candle_volume > 0) {

      const medianVolume1h = parseFloat(data.median_volume_1h || 0);

      const baseline_1h = medianVolume1h > 0
        ? medianVolume1h
        : (cs_volume / 24);

      volumeRatio = candle_volume / baseline_1h;

      const baselineMethod = medianVolume1h > 0
        ? 'Median 1h (12h history)'
        : 'Simple Avg (24h/24)';

      console.log(`  Baseline Method: ${baselineMethod}`);
      console.log(`  Baseline (1h): ${baseline_1h.toFixed(2)}`);
      console.log(`  Volume Ratio: ${volumeRatio.toFixed(3)} (current 1h / typical 1h)`);

      // Hard Disqualification — Volume Ratio < 0.3 (TRADING_PRINCIPLES §4.1)
      // Kept as a true drop-before-MERGE hard kill; nothing changes here.
      if (volumeRatio < 0.3) {
        return {
          score: 0,
          penalty: 0,
          ratio_multiplier: 0,
          volume_ratio: volumeRatio,
          status: 'HARD_DISQUALIFIED',
          disqualification_reason: 'VOLUME_CRITICALLY_LOW',
          volume_disqualified: true
        };
      }
    } else {
      console.log(`  ⚠️ Missing 1h candle volume data`);
    }
  }
  
  // =====================================================
  // COMPONENT 2: OBV ANALYSIS (30 points max) — [T-06] NORMALIZED
  //
  // OBV is a cumulative volume metric whose absolute magnitude scales with
  // the asset's lifetime traded volume (BTC OBV regularly in billions vs.
  // small altcoin OBV in tens of thousands). Absolute thresholds (1M / -1M)
  // produced near-binary classifications:
  //   - BTC/ETH: OBV almost always ≫ 1M → permanent +30 (max points)
  //   - Small altcoins: OBV almost never reaches 1M → permanent +5/+15
  // OBV lost its analytical value as a buying/selling-pressure proxy and
  // became a covert volume-tier proxy.
  //
  // Normalisation: obv_ratio = obv_1h / candle_volume.  This rescales OBV
  // to "cumulative pressure per unit recent 1h volume", which is comparable
  // across assets. Thresholds 0.5 / 0.1 / -0.1 / -0.5 give a meaningful
  // five-bucket split for both BTC and small caps.
  // =====================================================

  const obv_1h = parseFloat(data.obv_1h);

  if (!isNaN(obv_1h)) {
    maxScore += 30;

    const obvRatio = (!isNaN(candle_volume) && candle_volume > 0)
      ? obv_1h / candle_volume
      : 0;

    console.log(`  OBV (1h): ${obv_1h.toFixed(2)} | candle_volume: ${candle_volume} | ratio: ${obvRatio.toFixed(3)}`);

    if (obvRatio > 0.5) {
      totalScore += 30;
      console.log(`  Strong buying pressure (ratio > 0.5): +30 points`);
    } else if (obvRatio > 0.1) {
      totalScore += 25;
      console.log(`  Positive OBV pressure (ratio > 0.1): +25 points`);
    } else if (obvRatio > -0.1) {
      totalScore += 15;
      console.log(`  Neutral OBV pressure (|ratio| <= 0.1): +15 points`);
    } else if (obvRatio > -0.5) {
      totalScore += 10;
      console.log(`  Mild selling pressure (ratio > -0.5): +10 points`);
    } else {
      totalScore += 5;
      console.log(`  Strong selling pressure (ratio <= -0.5): +5 points`);
    }
  } else {
    console.log(`  OBV data unavailable`);
  }
  
  // =====================================================
  // COMPONENT 3: MFI ANALYSIS (20 points max)
  // =====================================================
  
  const mfi_2h = parseFloat(data.mfi_2h);
  
  if (!isNaN(mfi_2h)) {
    maxScore += 20;
    console.log(`  MFI (2h): ${mfi_2h.toFixed(2)}`);
    
    if (mfi_2h >= 50 && mfi_2h <= 70) {
      totalScore += 20;
      console.log(`  Optimal MFI zone: +20 points`);
    } else if (mfi_2h > 70 && mfi_2h <= 80) {
      totalScore += 15;
      console.log(`  Strong buying: +15 points`);
    } else if (mfi_2h > 80) {
      totalScore += 10;
      console.log(`  Overbought: +10 points`);
    } else if (mfi_2h >= 30 && mfi_2h < 50) {
      totalScore += 12;
      console.log(`  Neutral: +12 points`);
    } else if (mfi_2h >= 20 && mfi_2h < 30) {
      totalScore += 15;
      console.log(`  Oversold zone: +15 points`);
    } else {
      totalScore += 18;
      console.log(`  Extreme oversold: +18 points`);
    }
  } else {
    console.log(`  MFI data unavailable`);
  }
  
  // =====================================================
  // FINAL SCORE — [W-02 + T-05] ratio multiplier applied here
  //
  // Maps recent-vs-typical 1h volume into a multiplicative attenuation of the
  // composite volume_score (tier + OBV + MFI). Replaces the previous separate
  // volume_penalty subtract in VOLUME PENALTY APPLICATOR.
  //
  // Calibration (matches old severity at ratio ~0.55 while staying continuous):
  //   ratio >= 0.8       → 1.00 (normal/high volume — no attenuation)
  //   ratio 0.7-0.79     → 0.85
  //   ratio 0.6-0.69     → 0.65
  //   ratio 0.5-0.59     → 0.40
  //   ratio 0.3-0.49     → 0.20 (Hard Filters Enforcer still rejects ratio < 0.5;
  //                              this branch only fires if filter is loosened)
  //   ratio < 0.3        → hard disqualified above
  // =====================================================
  let ratioMultiplier = 1.0;
  let volumeStatusFromRatio = 'NORMAL';

  if (volumeRatio > 0) {
    if (volumeRatio >= 0.8)        { ratioMultiplier = 1.00; volumeStatusFromRatio = 'NORMAL'; }
    else if (volumeRatio >= 0.7)   { ratioMultiplier = 0.85; volumeStatusFromRatio = 'SLIGHTLY_LOW'; }
    else if (volumeRatio >= 0.6)   { ratioMultiplier = 0.65; volumeStatusFromRatio = 'BELOW_NORMAL'; }
    else if (volumeRatio >= 0.5)   { ratioMultiplier = 0.40; volumeStatusFromRatio = 'VERY_LOW'; }
    else                           { ratioMultiplier = 0.20; volumeStatusFromRatio = 'NEAR_DISQUALIFIED'; }
    console.log(`  Ratio Multiplier: ×${ratioMultiplier.toFixed(2)} (${volumeStatusFromRatio})`);
  }

  // [T-09] Fixed-denominator normalization (OBV 50 + Volume 30 + BBW 20 = 100).
  // Pre-fix: (totalScore / maxScore) * 100 inflated to 100% when only one
  // component had data. Missing components now correctly score 0 of their max.
  const STRUCTURAL_MAX = 100;
  const baseScore  = Math.round((totalScore / STRUCTURAL_MAX) * 100);
  const finalScore = Math.round(baseScore * ratioMultiplier);
  const dataCompletenessPct = Math.round((maxScore / STRUCTURAL_MAX) * 100);

  console.log(`  Volume Score: ${baseScore}/100 × ${ratioMultiplier.toFixed(2)} = ${finalScore}/100 | data_completeness: ${dataCompletenessPct}%`);

  return {
    score: finalScore,
    base_score: baseScore,
    ratio_multiplier: ratioMultiplier,
    penalty: 0,                       // [W-02] retained for backward compatibility; always 0 now
    volume_ratio: volumeRatio,
    status: volumeStatusFromRatio === 'NORMAL' ? 'GOOD' : volumeStatusFromRatio,
    data_completeness_pct: dataCompletenessPct
  };
}

// =====================================================
// PROCESS EACH SYMBOL
// =====================================================
const results = inputData
  .map(item => {
    const data = item.json;
    const volume = calculateVolumeScore(data);
    
    // Hard disqualified символи се филтрират тук — не достигат MERGE
    if (volume.volume_disqualified === true) {
      console.log(`  🚫 HARD DISQUALIFIED: ${data.symbol} | ratio: ${volume.volume_ratio.toFixed(3)} < 0.3 → dropped before MERGE`);
      return null;
    }
    
    return {
      json: {
        ...data,
        volume_score: volume.score,
        volume_base_score: volume.base_score,
        volume_ratio_multiplier: volume.ratio_multiplier,
        volume_penalty: volume.penalty,             // always 0 post W-02 (kept for audit + downstream compatibility)
        volume_ratio: volume.volume_ratio,
        volume_status: volume.status,
        volume_data_completeness_pct: volume.data_completeness_pct,
        scored_at: new Date().toISOString()
      }
    };
  })
  .filter(item => item !== null);  // remove hard-disqualified Symbols

console.log(`\n✅ Volume scoring complete for ${results.length} symbols`);

const avgScore = results.reduce((sum, r) => sum + (r.json.volume_score || 0), 0) / results.length;
console.log(`📊 Average Volume Score: ${avgScore.toFixed(1)}/100`);

const avgPenalty = results.reduce((sum, r) => sum + (r.json.volume_penalty || 0), 0) / results.length;
console.log(`📉 Average Penalty: ${avgPenalty.toFixed(1)} points`);

const statusCounts = {
  HARD_DISQUALIFIED: inputData.length - results.length,
  DISQUALIFIED: results.filter(r => r.json.volume_status === 'DISQUALIFIED').length,
  PENALIZED: results.filter(r => r.json.volume_status === 'PENALIZED').length,
  GOOD: results.filter(r => r.json.volume_status === 'GOOD').length
};

console.log(`\n📊 Volume Status Distribution:`);
console.log(`  🔴 HARD DISQUALIFIED: ${statusCounts.HARD_DISQUALIFIED} (ratio < 0.3 → dropped)`);
console.log(`  🚫 DISQUALIFIED: ${statusCounts.DISQUALIFIED} (ratio 0.3-0.5 → penalty -100)`);
console.log(`  ⚠️ PENALIZED: ${statusCounts.PENALIZED} (ratio 0.5-0.79)`);
console.log(`  ✅ GOOD: ${statusCounts.GOOD} (ratio >= 0.8)`);

return results;
