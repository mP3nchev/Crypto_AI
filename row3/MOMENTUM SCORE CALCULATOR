// =====================================================
// BRANCH 3: MOMENTUM SCORE CALCULATOR v2.0
// [T-09] Fixed normalization + real per-component contributions
// =====================================================
//
// Bugs fixed vs v1.0:
//
// 1) ASYMMETRIC NORMALIZATION (mirror of T-09 in TREND):
//    Old: finalScore = (totalScore / maxScore) * 100
//    maxScore was incremented per-component only when that component had
//    data, so a symbol with ONLY RSI (40 pts) and missing StochRSI/WillR
//    scored 40/40 = 100. Partial data → false "perfect momentum".
//    Fix: denominator fixed at structural max (40 + 30 + 30 = 100).
//
// 2) FAKE COMPONENTS REPORTING:
//    Old returned:
//      rsi_contribution: (totalScore/maxScore)*40       // ratio of ALL, not RSI
//      stochrsi_contribution: maxScore >= 30 ? 30 : 0   // always 30 when present
//      willr_contribution:    maxScore >= 30 ? 30 : 0   // always 30 when present
//    These never tracked actual per-indicator points and were useless for audit.
//    Fix: rsiContribution / stochrsiContribution / willrContribution are
//    accumulated as separate variables during scoring and reported as-is.
//
// 3) data_completeness_pct (maxScore/100) is exposed so SCORE AGGREGATOR
//    and SIGNAL RANKING can detect partial-data scoring downstream.
//
// Regime-aware T-01 calibration retained without changes:
//   STRONG_TREND (ADX >= 25):
//     RSI 60-75 bullish / 25-40 bearish = healthy continuation peak
//   NEUTRAL / RANGING (ADX < 25):
//     RSI 55-65 bullish / 35-45 bearish = sweet spot (reversal-aware)
//   ADX threshold mirrors ADX Market Condition Detector (Branch 1)
//   so both branches classify the same symbol identically.
// =====================================================

console.log('📈 === MOMENTUM SCORE CALCULATOR v2.0 START ===');

const inputData = $input.all();
console.log(`Calculating momentum scores for ${inputData.length} symbols`);

const STRUCTURAL_MAX_RSI      = 40;
const STRUCTURAL_MAX_STOCHRSI = 30;
const STRUCTURAL_MAX_WILLR    = 30;
const STRUCTURAL_MAX_TOTAL    = 100;

function getMomentumRegime(adxValue) {
  const adx = parseFloat(adxValue);
  if (isNaN(adx) || adx <= 0) return 'UNKNOWN';
  if (adx >= 25) return 'STRONG_TREND';
  if (adx >= 15) return 'NEUTRAL';
  return 'RANGING';
}

function calculateMomentumScore(scanData) {
  const regime = getMomentumRegime(scanData.adx_2h);

  // [T-09] Per-component contributions tracked separately
  let rsiContribution      = 0;
  let stochrsiContribution = 0;
  let willrContribution    = 0;

  // Track which components had usable data (for completeness metric)
  let rsiPresent      = false;
  let stochrsiPresent = false;
  let willrPresent    = false;

  // =====================================================
  // COMPONENT 1: RSI Multi-Timeframe (40 pts max) — regime-aware
  // =====================================================
  const rsi_2h = parseFloat(scanData.rsi_2h);
  const rsi_1h = parseFloat(scanData.rsi_1h);

  if (!isNaN(rsi_2h) && !isNaN(rsi_1h)) {
    rsiPresent = true;
    const bullish_2h = rsi_2h > 50;
    const bullish_1h = rsi_1h > 50;

    if (bullish_2h === bullish_1h) {
      const avg_rsi = (rsi_2h + rsi_1h) / 2;
      const bullish = bullish_2h;

      if (regime === 'STRONG_TREND') {
        if (bullish) {
          if (avg_rsi >= 60 && avg_rsi <= 75)      rsiContribution = 40;
          else if (avg_rsi > 75 && avg_rsi <= 85)  rsiContribution = 30;
          else if (avg_rsi > 85)                   rsiContribution = 15;
          else if (avg_rsi >= 55)                  rsiContribution = 30;
          else                                     rsiContribution = 20;
        } else {
          if (avg_rsi <= 40 && avg_rsi >= 25)      rsiContribution = 40;
          else if (avg_rsi < 25 && avg_rsi >= 15)  rsiContribution = 30;
          else if (avg_rsi < 15)                   rsiContribution = 15;
          else if (avg_rsi <= 45)                  rsiContribution = 30;
          else                                     rsiContribution = 20;
        }
      } else {
        if (bullish) {
          if (avg_rsi >= 55 && avg_rsi <= 65)      rsiContribution = 40;
          else if (avg_rsi > 65 && avg_rsi <= 75)  rsiContribution = 25;
          else if (avg_rsi > 75)                   rsiContribution = 10;
          else                                     rsiContribution = 20;
        } else {
          if (avg_rsi <= 45 && avg_rsi >= 35)      rsiContribution = 40;
          else if (avg_rsi < 35 && avg_rsi >= 25)  rsiContribution = 25;
          else if (avg_rsi < 25)                   rsiContribution = 10;
          else                                     rsiContribution = 20;
        }
      }
    } else {
      rsiContribution = 5; // 2h/1h conflict — momentum incoherent
    }
  }

  // =====================================================
  // COMPONENT 2: StochRSI (30 pts max) — regime-aware extreme handling
  // =====================================================
  const stoch_k_2h = parseFloat(scanData.stochrsi_k_2h);
  const stoch_k_1h = parseFloat(scanData.stochrsi_k_1h);

  if (!isNaN(stoch_k_2h) && !isNaN(stoch_k_1h)) {
    stochrsiPresent = true;
    const stochVal = stoch_k_1h;

    if (regime === 'STRONG_TREND') {
      if (stochVal >= 20 && stochVal <= 90)        stochrsiContribution = 30;
      else if (stochVal > 90)                      stochrsiContribution = 15;
      else                                         stochrsiContribution = 10;
    } else {
      if (stochVal >= 20 && stochVal <= 75)        stochrsiContribution = 30;
      else if (stochVal > 75 && stochVal <= 85)    stochrsiContribution = 15;
      else if (stochVal > 85)                      stochrsiContribution = 5;
      else if (stochVal < 20)                      stochrsiContribution = 10;
    }
  }

  // =====================================================
  // COMPONENT 3: Williams %R (30 pts max)
  // =====================================================
  const willr_2h = parseFloat(scanData.willr_2h);

  if (!isNaN(willr_2h)) {
    willrPresent = true;
    if (willr_2h >= -20)                           willrContribution = 10; // Overbought
    else if (willr_2h >= -50)                      willrContribution = 30; // Strong
    else if (willr_2h >= -80)                      willrContribution = 20; // Moderate
    else                                           willrContribution = 10; // Oversold
  }

  // =====================================================
  // [T-09] FIXED-DENOMINATOR NORMALIZATION
  // =====================================================
  const totalScore = rsiContribution + stochrsiContribution + willrContribution;
  const finalScore = Math.round((totalScore / STRUCTURAL_MAX_TOTAL) * 100);

  const presentMax =
    (rsiPresent      ? STRUCTURAL_MAX_RSI      : 0) +
    (stochrsiPresent ? STRUCTURAL_MAX_STOCHRSI : 0) +
    (willrPresent    ? STRUCTURAL_MAX_WILLR    : 0);
  const dataCompletenessPct = Math.round((presentMax / STRUCTURAL_MAX_TOTAL) * 100);

  return {
    score: finalScore,
    regime: regime,
    components: {
      rsi_contribution:      rsiContribution,
      stochrsi_contribution: stochrsiContribution,
      willr_contribution:    willrContribution,
      rsi_max:      STRUCTURAL_MAX_RSI,
      stochrsi_max: STRUCTURAL_MAX_STOCHRSI,
      willr_max:    STRUCTURAL_MAX_WILLR
    },
    components_present: {
      rsi:      rsiPresent,
      stochrsi: stochrsiPresent,
      willr:    willrPresent
    },
    data_completeness_pct: dataCompletenessPct
  };
}

// =====================================================
// PROCESS EACH SYMBOL
// =====================================================

const results = inputData.map(item => {
  const data = item.json;
  const scanData = data.scan_data || data;

  console.log(`\n--- ${data.symbol} ---`);

  const momentum = calculateMomentumScore(scanData);

  const c = momentum.components;
  console.log(
    `  RSI: ${c.rsi_contribution}/${c.rsi_max} | ` +
    `StochRSI: ${c.stochrsi_contribution}/${c.stochrsi_max} | ` +
    `WillR: ${c.willr_contribution}/${c.willr_max}`
  );
  console.log(
    `  Total: ${c.rsi_contribution + c.stochrsi_contribution + c.willr_contribution}/100 ` +
    `-> ${momentum.score}/100 | regime: ${momentum.regime} | ` +
    `data_completeness: ${momentum.data_completeness_pct}%`
  );

  return {
    json: {
      ...data,
      momentum_score: momentum.score,
      momentum_regime: momentum.regime,
      momentum_components: momentum.components,
      momentum_components_present: momentum.components_present,
      momentum_data_completeness_pct: momentum.data_completeness_pct,
      scored_at: new Date().toISOString(),
      momentum_calculator_version: 'v2.0 (T-09)'
    }
  };
});

console.log(`\n✅ Momentum scoring complete for ${results.length} symbols`);

const avgScore = results.reduce((sum, r) => sum + (r.json.momentum_score || 0), 0) / results.length;
const avgCompleteness = results.reduce((sum, r) => sum + (r.json.momentum_data_completeness_pct || 0), 0) / results.length;
console.log(`📊 Average Momentum Score: ${avgScore.toFixed(1)}/100`);
console.log(`📊 Average Data Completeness: ${avgCompleteness.toFixed(1)}%`);

console.log('\n✅ Ready for MERGE');

return results;
